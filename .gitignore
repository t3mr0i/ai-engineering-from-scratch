scripts/.pyodide/
ide/jupyter/lessons/
site/phases/
site/jupyterlite/

# Lesson content bundled with the gated api/content function — staged from
# phases/ at deploy time (see .github/workflows/azure-static-web-apps.yml
# and serve.sh), same reasoning as site/phases/ above.
api/content/_data/

# Lazyweb MCP tool cache
.lazyweb/

# Local curriculum-admin drafts. Production uses ADMIN_DATA_DIR on a PVC.
.admin-data/

# Subagent-driven-development scratch workspace (ledgers, briefs, review
# packages) — git history is the record once a plan finishes, not this.
.superpowers/sdd/

