{
  "routes": [
    { "route": "/gate.html", "allowedRoles": ["anonymous"] },
    { "route": "/api/gate", "allowedRoles": ["anonymous"] },
    { "route": "/api/check", "allowedRoles": ["anonymous"] },
    { "route": "/api/content", "allowedRoles": ["anonymous"] },
    { "route": "/api/llm/chat/completions", "allowedRoles": ["anonymous"] },

    { "route": "/glossary", "rewrite": "/glossary.html" },
    { "route": "/path", "rewrite": "/prereqs.html" },
    { "route": "/roadmap", "rewrite": "/prereqs.html" },
    { "route": "/about", "rewrite": "/about.html" }
  ],
  "platform": {
    "apiRuntime": "node:18"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff"
  },
  "mimeTypes": {
    ".md": "text/markdown",
    ".json": "application/json"
  }
}
