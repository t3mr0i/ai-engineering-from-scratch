      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    capabilities: { streaming: true, pushNotifications: false },"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    defaultInputModes: [\"text/plain\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    defaultOutputModes: [\"text/plain\", \"application/json\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    skills: ["
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "      {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        id: \"web-research\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        name: \"Web Research\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        description: \"Searches the web\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        tags: [\"research\", \"search\", \"summarization\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        inputModes: [\"text/plain\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        outputModes: [\"application/json\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "      },"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    ],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "  });"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "  registry.register({"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    name: \"coder\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    description: \"Writes code from specs\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    version: \"1.0.0\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    url: \"https://coder.local/a2a/v1\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    capabilities: { streaming: false, pushNotifications: false },"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    defaultInputModes: [\"text/plain\", \"application/json\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    defaultOutputModes: [\"text/plain\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    skills: ["
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "      {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        id: \"code-gen\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        name: \"Code Generation\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        description: \"Generates code\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        tags: [\"coding\", \"generation\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        inputModes: [\"text/plain\", \"application/json\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        outputModes: [\"text/plain\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "      },"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    ],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "  });"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "  const taskManager = new TaskManager();"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "  const auditRunner = new AuditableRunner();"
      ]
