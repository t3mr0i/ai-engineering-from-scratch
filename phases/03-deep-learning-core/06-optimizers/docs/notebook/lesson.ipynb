{
  "cells": [
    {
      "cell_type": "markdown",
      "source": [
        "# Optimizers Notebook\n\n> Hands-on Build It and Exercises."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Build It"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 1: Vanilla SGD"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class SGD:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, lr=0.01):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.lr = lr"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def step(self, params, grads):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i in range(len(params)):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            params[i] -= self.lr * grads[i]"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 2: SGD with Momentum"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class SGDMomentum:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, lr=0.01, beta=0.9):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.lr = lr"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.beta = beta"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.velocities = None"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def step(self, params, grads):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if self.velocities is None:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.velocities = [0.0] * len(params)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i in range(len(params)):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.velocities[i] = self.beta * self.velocities[i] + grads[i]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            params[i] -= self.lr * self.velocities[i]"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 3: Adam"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import math"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class Adam:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, lr=0.001, beta1=0.9, beta2=0.999, epsilon=1e-8):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.lr = lr"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.beta1 = beta1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.beta2 = beta2"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.epsilon = epsilon"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.m = None"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.v = None"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.t = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def step(self, params, grads):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if self.m is None:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.m = [0.0] * len(params)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.v = [0.0] * len(params)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.t += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i in range(len(params)):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.m[i] = self.beta1 * self.m[i] + (1 - self.beta1) * grads[i]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.v[i] = self.beta2 * self.v[i] + (1 - self.beta2) * grads[i] ** 2"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            m_hat = self.m[i] / (1 - self.beta1 ** self.t)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            v_hat = self.v[i] / (1 - self.beta2 ** self.t)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            params[i] -= self.lr * m_hat / (math.sqrt(v_hat) + self.epsilon)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 4: AdamW"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class AdamW:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, lr=0.001, beta1=0.9, beta2=0.999, epsilon=1e-8, weight_decay=0.01):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.lr = lr"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.beta1 = beta1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.beta2 = beta2"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.epsilon = epsilon"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.weight_decay = weight_decay"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.m = None"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.v = None"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.t = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def step(self, params, grads):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if self.m is None:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.m = [0.0] * len(params)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.v = [0.0] * len(params)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.t += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i in range(len(params)):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.m[i] = self.beta1 * self.m[i] + (1 - self.beta1) * grads[i]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.v[i] = self.beta2 * self.v[i] + (1 - self.beta2) * grads[i] ** 2"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            m_hat = self.m[i] / (1 - self.beta1 ** self.t)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            v_hat = self.v[i] / (1 - self.beta2 ** self.t)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            params[i] -= self.lr * m_hat / (math.sqrt(v_hat) + self.epsilon)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            params[i] -= self.lr * self.weight_decay * params[i]"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 5: Training Comparison"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Train the same two-layer network on the circle dataset from lesson 05 with all four optimizers. Compare convergence."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import random"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def sigmoid(x):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    x = max(-500, min(500, x))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return 1.0 / (1.0 + math.exp(-x))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def make_circle_data(n=200, seed=42):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    random.seed(seed)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    data = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for _ in range(n):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        x = random.uniform(-2, 2)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        y = random.uniform(-2, 2)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        label = 1.0 if x * x + y * y < 1.5 else 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        data.append(([x, y], label))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return data"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class OptimizerTestNetwork:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, optimizer, hidden_size=8):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        random.seed(0)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.hidden_size = hidden_size"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.optimizer = optimizer"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.w1 = [[random.gauss(0, 0.5) for _ in range(2)] for _ in range(hidden_size)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.b1 = [0.0] * hidden_size"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.w2 = [random.gauss(0, 0.5) for _ in range(hidden_size)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.b2 = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def get_params(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        params = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for row in self.w1:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            params.extend(row)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        params.extend(self.b1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        params.extend(self.w2)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        params.append(self.b2)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return params"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def set_params(self, params):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        idx = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i in range(self.hidden_size):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for j in range(2):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self.w1[i][j] = params[idx]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                idx += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i in range(self.hidden_size):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.b1[i] = params[idx]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            idx += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i in range(self.hidden_size):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.w2[i] = params[idx]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            idx += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.b2 = params[idx]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def forward(self, x):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.x = x"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.z1 = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.h = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i in range(self.hidden_size):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            z = self.w1[i][0] * x[0] + self.w1[i][1] * x[1] + self.b1[i]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.z1.append(z)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.h.append(max(0.0, z))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.z2 = sum(self.w2[i] * self.h[i] for i in range(self.hidden_size)) + self.b2"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.out = sigmoid(self.z2)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return self.out"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def compute_grads(self, target):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        eps = 1e-15"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        p = max(eps, min(1 - eps, self.out))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        d_loss = -(target / p) + (1 - target) / (1 - p)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        d_sigmoid = self.out * (1 - self.out)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        d_out = d_loss * d_sigmoid"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        grads = [0.0] * (self.hidden_size * 2 + self.hidden_size + self.hidden_size + 1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        idx = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i in range(self.hidden_size):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            d_relu = 1.0 if self.z1[i] > 0 else 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            d_h = d_out * self.w2[i] * d_relu"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            grads[idx] = d_h * self.x[0]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            grads[idx + 1] = d_h * self.x[1]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            idx += 2"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i in range(self.hidden_size):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            d_relu = 1.0 if self.z1[i] > 0 else 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            grads[idx] = d_out * self.w2[i] * d_relu"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            idx += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i in range(self.hidden_size):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            grads[idx] = d_out * self.h[i]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            idx += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        grads[idx] = d_out"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return grads"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def train(self, data, epochs=300):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        losses = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for epoch in range(epochs):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            total_loss = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            correct = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for x, y in data:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                pred = self.forward(x)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                grads = self.compute_grads(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                params = self.get_params()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self.optimizer.step(params, grads)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self.set_params(params)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                eps = 1e-15"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                p = max(eps, min(1 - eps, pred))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                total_loss += -(y * math.log(p) + (1 - y) * math.log(1 - p))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                if (pred >= 0.5) == (y >= 0.5):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                    correct += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            avg_loss = total_loss / len(data)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            accuracy = correct / len(data) * 100"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            losses.append((avg_loss, accuracy))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if epoch % 75 == 0 or epoch == epochs - 1:"
      ]
