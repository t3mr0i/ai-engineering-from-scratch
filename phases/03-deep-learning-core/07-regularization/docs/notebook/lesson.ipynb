{
  "cells": [
    {
      "cell_type": "markdown",
      "source": [
        "# Regularization Notebook\n\n> Hands-on Build It and Exercises."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Build It"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 1: Dropout (Train and Eval Mode)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import random"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import math"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class Dropout:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, p=0.5):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.p = p"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.training = True"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.mask = None"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def forward(self, x):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if not self.training:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            return list(x)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.mask = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        output = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for val in x:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if random.random() < self.p:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self.mask.append(0)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                output.append(0.0)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            else:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self.mask.append(1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                output.append(val / (1 - self.p))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return output"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def backward(self, grad_output):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        grads = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for g, m in zip(grad_output, self.mask):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if m == 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                grads.append(0.0)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            else:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                grads.append(g / (1 - self.p))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return grads"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 2: L2 Weight Decay"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def l2_regularization(weights, lambda_reg):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    penalty = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for w in weights:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        penalty += w * w"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return lambda_reg * 0.5 * penalty"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def l2_gradient(weights, lambda_reg):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return [lambda_reg * w for w in weights]"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 3: Batch Normalization"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class BatchNorm:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, num_features, momentum=0.1, eps=1e-5):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.gamma = [1.0] * num_features"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.beta = [0.0] * num_features"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.eps = eps"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.momentum = momentum"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.running_mean = [0.0] * num_features"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.running_var = [1.0] * num_features"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.training = True"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.num_features = num_features"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def forward(self, batch):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        batch_size = len(batch)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if self.training:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            mean = [0.0] * self.num_features"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for sample in batch:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                for j in range(self.num_features):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                    mean[j] += sample[j]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            mean = [m / batch_size for m in mean]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            var = [0.0] * self.num_features"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for sample in batch:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                for j in range(self.num_features):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                    var[j] += (sample[j] - mean[j]) ** 2"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            var = [v / batch_size for v in var]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for j in range(self.num_features):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self.running_mean[j] = (1 - self.momentum) * self.running_mean[j] + self.momentum * mean[j]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self.running_var[j] = (1 - self.momentum) * self.running_var[j] + self.momentum * var[j]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        else:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            mean = list(self.running_mean)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            var = list(self.running_var)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.x_hat = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        output = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for sample in batch:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            normalized = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            out_sample = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for j in range(self.num_features):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                x_h = (sample[j] - mean[j]) / math.sqrt(var[j] + self.eps)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                normalized.append(x_h)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                out_sample.append(self.gamma[j] * x_h + self.beta[j])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.x_hat.append(normalized)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            output.append(out_sample)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return output"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 4: Layer Normalization"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class LayerNorm:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, num_features, eps=1e-5):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.gamma = [1.0] * num_features"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.beta = [0.0] * num_features"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.eps = eps"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.num_features = num_features"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def forward(self, x):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        mean = sum(x) / len(x)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        var = sum((xi - mean) ** 2 for xi in x) / len(x)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.x_hat = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        output = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for j in range(self.num_features):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            x_h = (x[j] - mean) / math.sqrt(var + self.eps)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.x_hat.append(x_h)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            output.append(self.gamma[j] * x_h + self.beta[j])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return output"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 5: RMSNorm"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class RMSNorm:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, num_features, eps=1e-6):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.gamma = [1.0] * num_features"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.eps = eps"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.num_features = num_features"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def forward(self, x):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        rms = math.sqrt(sum(xi * xi for xi in x) / len(x) + self.eps)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        output = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for j in range(self.num_features):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            output.append(self.gamma[j] * x[j] / rms)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return output"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 6: Training With and Without Regularization"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def sigmoid(x):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    x = max(-500, min(500, x))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return 1.0 / (1.0 + math.exp(-x))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def make_circle_data(n=200, seed=42):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    random.seed(seed)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    data = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for _ in range(n):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        x = random.uniform(-2, 2)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        y = random.uniform(-2, 2)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        label = 1.0 if x * x + y * y < 1.5 else 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        data.append(([x, y], label))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return data"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class RegularizedNetwork:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, hidden_size=16, lr=0.05, dropout_p=0.0, weight_decay=0.0):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        random.seed(0)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.hidden_size = hidden_size"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.lr = lr"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.dropout_p = dropout_p"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.weight_decay = weight_decay"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.dropout = Dropout(p=dropout_p) if dropout_p > 0 else None"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.w1 = [[random.gauss(0, 0.5) for _ in range(2)] for _ in range(hidden_size)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.b1 = [0.0] * hidden_size"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.w2 = [random.gauss(0, 0.5) for _ in range(hidden_size)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.b2 = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def forward(self, x, training=True):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.x = x"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.z1 = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.h = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i in range(self.hidden_size):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            z = self.w1[i][0] * x[0] + self.w1[i][1] * x[1] + self.b1[i]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.z1.append(z)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.h.append(max(0.0, z))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if self.dropout and training:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.dropout.training = True"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.h = self.dropout.forward(self.h)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        elif self.dropout:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.dropout.training = False"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.h = self.dropout.forward(self.h)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.z2 = sum(self.w2[i] * self.h[i] for i in range(self.hidden_size)) + self.b2"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.out = sigmoid(self.z2)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return self.out"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def backward(self, target):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        eps = 1e-15"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        p = max(eps, min(1 - eps, self.out))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        d_loss = -(target / p) + (1 - target) / (1 - p)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        d_sigmoid = self.out * (1 - self.out)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        d_out = d_loss * d_sigmoid"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i in range(self.hidden_size):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            d_relu = 1.0 if self.z1[i] > 0 else 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            d_h = d_out * self.w2[i] * d_relu"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.w2[i] -= self.lr * (d_out * self.h[i] + self.weight_decay * self.w2[i])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for j in range(2):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self.w1[i][j] -= self.lr * (d_h * self.x[j] + self.weight_decay * self.w1[i][j])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.b1[i] -= self.lr * d_h"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.b2 -= self.lr * d_out"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def evaluate(self, data):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        correct = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        total_loss = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for x, y in data:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            pred = self.forward(x, training=False)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            eps = 1e-15"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            p = max(eps, min(1 - eps, pred))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            total_loss += -(y * math.log(p) + (1 - y) * math.log(1 - p))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if (pred >= 0.5) == (y >= 0.5):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                correct += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return total_loss / len(data), correct / len(data) * 100"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def train_model(self, train_data, test_data, epochs=300):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        history = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for epoch in range(epochs):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            total_loss = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            correct = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for x, y in train_data:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                pred = self.forward(x, training=True)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self.backward(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                eps = 1e-15"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                p = max(eps, min(1 - eps, pred))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                total_loss += -(y * math.log(p) + (1 - y) * math.log(1 - p))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                if (pred >= 0.5) == (y >= 0.5):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                    correct += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            train_loss = total_loss / len(train_data)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            train_acc = correct / len(train_data) * 100"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            test_loss, test_acc = self.evaluate(test_data)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            history.append((train_loss, train_acc, test_loss, test_acc))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if epoch % 75 == 0 or epoch == epochs - 1:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                gap = train_acc - test_acc"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                print(f\"    Epoch {epoch:3d}: train_acc={train_acc:.1f}%, test_acc={test_acc:.1f}%, gap={gap:.1f}%\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return history"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
