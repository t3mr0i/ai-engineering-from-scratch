      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "config = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"hidden_size\": 4096, \"intermediate_size\": 14336,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"num_hidden_layers\": 32, \"num_attention_heads\": 32,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
