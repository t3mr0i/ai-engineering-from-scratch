      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"num_layers\": 120, \"num_kv_heads\": 96, \"head_dim\": 128,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"model_params_b\": 1800, \"gqa\": False,"
      ]
    },
