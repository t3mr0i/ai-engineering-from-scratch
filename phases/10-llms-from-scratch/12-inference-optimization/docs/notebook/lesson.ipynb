      "source": [
        "    \"Mistral-7B\": {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"num_layers\": 32, \"num_kv_heads\": 8, \"head_dim\": 128,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
