        "        \"num_layers\": 80, \"num_kv_heads\": 8, \"head_dim\": 128,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"model_params_b\": 70, \"gqa\": True,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    },"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"Llama-3-405B\": {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"num_layers\": 126, \"num_kv_heads\": 8, \"head_dim\": 128,"
      ]
    },
    {
      "cell_type": "markdown",
