{
  "cells": [
    {
      "cell_type": "markdown",
      "source": [
        "# Build a Complete Vision Pipeline \u2014 Capstone Notebook\n\n> Hands-on Build It and Exercises."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Build It"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 1: Data contracts"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "from pydantic import BaseModel, Field"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "from typing import List, Optional, Tuple"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class Detection(BaseModel):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    box: Tuple[float, float, float, float]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    score: float = Field(ge=0, le=1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    class_id: int = Field(ge=0)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    mask_rle: Optional[str] = None"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class Classification(BaseModel):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    detection_index: int"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    class_id: int"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    class_name: str"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    score: float = Field(ge=0, le=1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class PipelineResult(BaseModel):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    image_id: str"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    detections: List[Detection]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    classifications: List[Classification]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    inference_ms: float"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Five seconds of code saves an hour of debugging on any serious pipeline."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 2: A minimal Pipeline class"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import time"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import numpy as np"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import torch"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "from PIL import Image"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class VisionPipeline:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, detector, classifier, class_names,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                 device=\"cpu\", min_crop=32):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.detector = detector.to(device).eval()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.classifier = classifier.to(device).eval()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.class_names = class_names"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.device = device"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.min_crop = min_crop"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def preprocess(self, image):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"\"\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        image: PIL.Image or np.ndarray (H, W, 3) uint8"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        returns: CHW float tensor on device"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"\"\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if isinstance(image, Image.Image):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            image = np.asarray(image.convert(\"RGB\"))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        tensor = torch.from_numpy(image).permute(2, 0, 1).float() / 255.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return tensor.to(self.device)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    @torch.no_grad()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def detect(self, image_tensor):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return self.detector([image_tensor])[0]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    @torch.no_grad()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def classify(self, crops):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if len(crops) == 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            return []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        batch = torch.stack(crops).to(self.device)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        logits = self.classifier(batch)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        probs = logits.softmax(-1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        scores, cls = probs.max(-1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return list(zip(cls.tolist(), scores.tolist()))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def run(self, image, image_id=\"anonymous\"):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        t0 = time.perf_counter()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        tensor = self.preprocess(image)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        det = self.detect(tensor)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        crops = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        detections = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        valid_indices = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i, (box, score, cls) in enumerate(zip(det[\"boxes\"], det[\"scores\"], det[\"labels\"])):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            x1, y1, x2, y2 = [max(0, int(b)) for b in box.tolist()]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            x2 = min(x2, tensor.shape[-1])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            y2 = min(y2, tensor.shape[-2])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            detections.append(Detection("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                box=(x1, y1, x2, y2),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                score=float(score),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                class_id=int(cls),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            ))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if (x2 - x1) < self.min_crop or (y2 - y1) < self.min_crop:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                continue"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            crop = tensor[:, y1:y2, x1:x2]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            crop = torch.nn.functional.interpolate("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                crop.unsqueeze(0),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                size=(224, 224),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                mode=\"bilinear\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                align_corners=False,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            )[0]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            crops.append(crop)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            valid_indices.append(i)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        class_preds = self.classify(crops)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        classifications = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for valid_idx, (cls_id, cls_score) in zip(valid_indices, class_preds):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            classifications.append(Classification("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                detection_index=valid_idx,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                class_id=int(cls_id),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                class_name=self.class_names[cls_id],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                score=float(cls_score),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            ))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return PipelineResult("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            image_id=image_id,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            detections=detections,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            classifications=classifications,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            inference_ms=(time.perf_counter() - t0) * 1000,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        )"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Every interface is typed. Every failure path has a specific handling decision."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 3: Wire a detector and a classifier"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "from torchvision.models.detection import maskrcnn_resnet50_fpn_v2"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "from torchvision.models import convnext_tiny"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# Use ImageNet-pretrained weights for a realistic pipeline without training"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "detector = maskrcnn_resnet50_fpn_v2(weights=\"DEFAULT\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "classifier = convnext_tiny(weights=\"DEFAULT\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class_names = [f\"imagenet_class_{i}\" for i in range(1000)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "pipe = VisionPipeline(detector, classifier, class_names)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# Smoke test with a synthetic image"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "test_image = (np.random.rand(400, 600, 3) * 255).astype(np.uint8)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "result = pipe.run(test_image, image_id=\"demo\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(result.model_dump_json(indent=2)[:500])"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 4: FastAPI service"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "from fastapi import FastAPI, UploadFile, HTTPException"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "from io import BytesIO"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "app = FastAPI()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "pipe = None  # initialised on startup"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "@app.on_event(\"startup\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def load():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    global pipe"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    detector = maskrcnn_resnet50_fpn_v2(weights=\"DEFAULT\").eval()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    classifier = convnext_tiny(weights=\"DEFAULT\").eval()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    pipe = VisionPipeline(detector, classifier, class_names=[f\"c{i}\" for i in range(1000)])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "@app.post(\"/detect\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "async def detect_endpoint(file: UploadFile):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if file.content_type not in {\"image/jpeg\", \"image/png\", \"image/webp\"}:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        raise HTTPException(status_code=400, detail=\"unsupported image type\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    data = await file.read()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    try:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        img = Image.open(BytesIO(data)).convert(\"RGB\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    except Exception:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        raise HTTPException(status_code=400, detail=\"cannot decode image\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    result = pipe.run(img, image_id=file.filename or \"upload\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return result.model_dump()"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Run with `uvicorn main:app --host 0.0.0.0 --port 8000`. Test with `curl -F 'file=@dog.jpg' http://localhost:8000/detect`."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 5: Benchmark the pipeline"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import time"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def benchmark(pipe, num_runs=20, image_size=(400, 600)):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    img = (np.random.rand(*image_size, 3) * 255).astype(np.uint8)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    pipe.run(img)  # warm up"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    stages = {\"preprocess\": [], \"detect\": [], \"classify\": [], \"total\": []}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for _ in range(num_runs):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        t0 = time.perf_counter()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        tensor = pipe.preprocess(img)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        t1 = time.perf_counter()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        det = pipe.detect(tensor)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        t2 = time.perf_counter()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        crops = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for box in det[\"boxes\"]:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            x1, y1, x2, y2 = [max(0, int(b)) for b in box.tolist()]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            x2 = min(x2, tensor.shape[-1])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            y2 = min(y2, tensor.shape[-2])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if (x2 - x1) >= pipe.min_crop and (y2 - y1) >= pipe.min_crop:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                crop = tensor[:, y1:y2, x1:x2]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                crop = torch.nn.functional.interpolate("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                    crop.unsqueeze(0), size=(224, 224), mode=\"bilinear\", align_corners=False"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                )[0]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                crops.append(crop)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        pipe.classify(crops)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        t3 = time.perf_counter()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        stages[\"preprocess\"].append((t1 - t0) * 1000)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        stages[\"detect\"].append((t2 - t1) * 1000)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        stages[\"classify\"].append((t3 - t2) * 1000)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        stages[\"total\"].append((t3 - t0) * 1000)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for stage, times in stages.items():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        times.sort()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(f\"{stage:12s}  p50={times[len(times)//2]:7.1f} ms  p95={times[int(len(times)*0.95)]:7.1f} ms\")"
      ]
    },
    {
      "cell_type": "code",
