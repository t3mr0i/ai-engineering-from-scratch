      "cell_type": "markdown",
      "source": [
        "### Step 4: Build the Confidence Interval Calculator"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Statistical rigor separates real evaluation from vibes."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def wilson_confidence_interval(successes, total, z=1.96):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if total == 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return (0.0, 0.0)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    p = successes / total"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    denominator = 1 + z * z / total"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    center = (p + z * z / (2 * total)) / denominator"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    spread = z * math.sqrt((p * (1 - p) + z * z / (4 * total)) / total) / denominator"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    lower = max(0.0, center - spread)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    upper = min(1.0, center + spread)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return (round(lower, 4), round(upper, 4))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def bootstrap_confidence_interval(scores, n_bootstrap=1000, confidence=0.95):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if len(scores) < 2:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return (0.0, 0.0, 0.0)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    n = len(scores)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    means = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    seed_base = int(sum(scores) * 1000) % 2**31"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for i in range(n_bootstrap):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        seed = (seed_base + i * 7919) % 2**31"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        sample = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for j in range(n):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            idx = (seed + j * 31) % n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            sample.append(scores[idx])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            seed = (seed * 1103515245 + 12345) % 2**31"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        means.append(sum(sample) / len(sample))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    means.sort()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    alpha = (1 - confidence) / 2"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    lower_idx = int(alpha * n_bootstrap)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    upper_idx = int((1 - alpha) * n_bootstrap) - 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    mean = sum(scores) / len(scores)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return (round(means[lower_idx], 4), round(mean, 4), round(means[upper_idx], 4))"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
