        "        output = run_model(model_name, tc.input_text)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        scores = score_with_llm_judge(tc.input_text, output, tc.reference_output, criteria)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        result = EvalResult("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            test_case_id=tc.id,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            model_output=output,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            scores=scores,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            model=model_name,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            prompt_version=prompt_version,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        )"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        results.append(result)"
