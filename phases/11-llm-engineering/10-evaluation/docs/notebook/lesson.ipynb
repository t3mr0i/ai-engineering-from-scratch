    {
      "cell_type": "markdown",
      "source": [
        "    for i in range(1, m + 1):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for j in range(1, n + 1):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            # Hint: if the tokens match, extend the diagonal (dp[i-1][j-1] + 1)."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            # Otherwise carry the better of dropping one token from either side."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            dp[i][j] = 0  # <-- replace this line"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    lcs_length = dp[m][n]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if lcs_length == 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    precision = lcs_length / n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    recall = lcs_length / m"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return round(2 * precision * recall / (precision + recall), 4)"
      ]
    },
