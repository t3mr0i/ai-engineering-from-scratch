{
  "cells": [
    {
      "cell_type": "markdown",
      "source": [
        "# Caching, Rate Limiting & Cost Optimization Notebook\n\n> Hands-on Build It and Exercises."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Build It"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 1: Cost Calculator"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Build a token cost calculator that knows current pricing for major models."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import hashlib"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import time"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import json"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import math"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "from dataclasses import dataclass, field"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "MODEL_PRICING = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"gpt-4o\": {\"input\": 2.50, \"output\": 10.00, \"cached_input\": 1.25},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"gpt-4o-mini\": {\"input\": 0.15, \"output\": 0.60, \"cached_input\": 0.075},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"gpt-4.1\": {\"input\": 2.00, \"output\": 8.00, \"cached_input\": 0.50},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"gpt-4.1-mini\": {\"input\": 0.40, \"output\": 1.60, \"cached_input\": 0.10},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"gpt-4.1-nano\": {\"input\": 0.10, \"output\": 0.40, \"cached_input\": 0.025},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"o3\": {\"input\": 2.00, \"output\": 8.00, \"cached_input\": 0.50},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"o3-mini\": {\"input\": 1.10, \"output\": 4.40, \"cached_input\": 0.55},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"o4-mini\": {\"input\": 1.10, \"output\": 4.40, \"cached_input\": 0.275},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"claude-opus-4\": {\"input\": 15.00, \"output\": 75.00, \"cached_input\": 1.50},  # placeholder: verify cache_read rate on docs.anthropic.com before quoting"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"claude-sonnet-4\": {\"input\": 3.00, \"output\": 15.00, \"cached_input\": 0.30},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"claude-haiku-3.5\": {\"input\": 0.80, \"output\": 4.00, \"cached_input\": 0.08},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"gemini-2.5-pro\": {\"input\": 1.25, \"output\": 10.00, \"cached_input\": 0.3125},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"gemini-2.5-flash\": {\"input\": 0.15, \"output\": 0.60, \"cached_input\": 0.0375},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def calculate_cost(model, input_tokens, output_tokens, cached_input_tokens=0):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if model not in MODEL_PRICING:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {\"error\": f\"Unknown model: {model}\"}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    pricing = MODEL_PRICING[model]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    non_cached = input_tokens - cached_input_tokens"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    input_cost = (non_cached / 1_000_000) * pricing[\"input\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    cached_cost = (cached_input_tokens / 1_000_000) * pricing[\"cached_input\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    output_cost = (output_tokens / 1_000_000) * pricing[\"output\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    total = input_cost + cached_cost + output_cost"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"model\": model,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"input_tokens\": input_tokens,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"output_tokens\": output_tokens,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"cached_input_tokens\": cached_input_tokens,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"input_cost\": round(input_cost, 6),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"cached_input_cost\": round(cached_cost, 6),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"output_cost\": round(output_cost, 6),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"total_cost\": round(total, 6),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    }"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 2: Exact Cache"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Hash the full prompt and return cached responses for identical requests."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class ExactCache:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, max_size=1000, ttl_seconds=3600):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.cache = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.max_size = max_size"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.ttl = ttl_seconds"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.hits = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.misses = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def _hash(self, model, messages, temperature):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        key_data = json.dumps({\"model\": model, \"messages\": messages, \"temperature\": temperature}, sort_keys=True)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return hashlib.sha256(key_data.encode()).hexdigest()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def get(self, model, messages, temperature=0.0):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if temperature > 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.misses += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            return None"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        key = self._hash(model, messages, temperature)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if key in self.cache:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            entry = self.cache[key]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if time.time() - entry[\"timestamp\"] < self.ttl:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self.hits += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                entry[\"access_count\"] += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                return entry[\"response\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            del self.cache[key]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.misses += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return None"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def put(self, model, messages, temperature, response):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if temperature > 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            return"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if len(self.cache) >= self.max_size:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            oldest_key = min(self.cache, key=lambda k: self.cache[k][\"timestamp\"])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            del self.cache[oldest_key]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        key = self._hash(model, messages, temperature)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.cache[key] = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"response\": response,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"timestamp\": time.time(),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"access_count\": 1,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        }"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def stats(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        total = self.hits + self.misses"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"hits\": self.hits,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"misses\": self.misses,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"hit_rate\": round(self.hits / total, 4) if total > 0 else 0,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"cache_size\": len(self.cache),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        }"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 3: Semantic Cache"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Embed queries and return cached responses when similarity exceeds a threshold."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def simple_embed(text):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    words = text.lower().split()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    vocab = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for w in words:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        vocab[w] = vocab.get(w, 0) + 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    norm = math.sqrt(sum(v * v for v in vocab.values()))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if norm == 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return {k: v / norm for k, v in vocab.items()}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def cosine_similarity(a, b):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if not a or not b:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    all_keys = set(a) | set(b)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    dot = sum(a.get(k, 0) * b.get(k, 0) for k in all_keys)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return dot"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class SemanticCache:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, similarity_threshold=0.85, max_size=500, ttl_seconds=3600):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.entries = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.threshold = similarity_threshold"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.max_size = max_size"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.ttl = ttl_seconds"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.hits = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.misses = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def get(self, query):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        query_embedding = simple_embed(query)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        now = time.time()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        best_match = None"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        best_sim = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for entry in self.entries:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if now - entry[\"timestamp\"] > self.ttl:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                continue"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            sim = cosine_similarity(query_embedding, entry[\"embedding\"])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if sim > best_sim:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                best_sim = sim"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                best_match = entry"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if best_match and best_sim >= self.threshold:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.hits += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            best_match[\"access_count\"] += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            return {\"response\": best_match[\"response\"], \"similarity\": round(best_sim, 4), \"original_query\": best_match[\"query\"]}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.misses += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return None"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def put(self, query, response):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if len(self.entries) >= self.max_size:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.entries.sort(key=lambda e: e[\"timestamp\"])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.entries.pop(0)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.entries.append({"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"query\": query,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"embedding\": simple_embed(query),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"response\": response,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"timestamp\": time.time(),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"access_count\": 1,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        })"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def stats(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        total = self.hits + self.misses"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"hits\": self.hits,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"misses\": self.misses,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"hit_rate\": round(self.hits / total, 4) if total > 0 else 0,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"cache_size\": len(self.entries),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        }"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 4: Rate Limiter"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Token bucket rate limiter with per-user quotas."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class TokenBucketRateLimiter:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.buckets = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.tiers = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"free\": {\"capacity\": 50_000, \"refill_rate\": 500, \"max_requests_per_min\": 10},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"pro\": {\"capacity\": 500_000, \"refill_rate\": 5_000, \"max_requests_per_min\": 60},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"enterprise\": {\"capacity\": 5_000_000, \"refill_rate\": 50_000, \"max_requests_per_min\": 300},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        }"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def _get_bucket(self, user_id, tier=\"free\"):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if user_id not in self.buckets:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            tier_config = self.tiers.get(tier, self.tiers[\"free\"])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.buckets[user_id] = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"tokens\": tier_config[\"capacity\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"capacity\": tier_config[\"capacity\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"refill_rate\": tier_config[\"refill_rate\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"last_refill\": time.time(),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"request_timestamps\": [],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"max_rpm\": tier_config[\"max_requests_per_min\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"tier\": tier,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"total_tokens_used\": 0,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            }"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return self.buckets[user_id]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def _refill(self, bucket):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        now = time.time()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        elapsed = now - bucket[\"last_refill\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        refill = int(elapsed * bucket[\"refill_rate\"])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if refill > 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            bucket[\"tokens\"] = min(bucket[\"capacity\"], bucket[\"tokens\"] + refill)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            bucket[\"last_refill\"] = now"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def check(self, user_id, tokens_needed, tier=\"free\"):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        bucket = self._get_bucket(user_id, tier)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self._refill(bucket)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        now = time.time()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        bucket[\"request_timestamps\"] = [t for t in bucket[\"request_timestamps\"] if now - t < 60]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if len(bucket[\"request_timestamps\"]) >= bucket[\"max_rpm\"]:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            return {\"allowed\": False, \"reason\": \"rate_limit\", \"retry_after_seconds\": 60 - (now - bucket[\"request_timestamps\"][0])}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if bucket[\"tokens\"] < tokens_needed:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            deficit = tokens_needed - bucket[\"tokens\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            wait = deficit / bucket[\"refill_rate\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            return {\"allowed\": False, \"reason\": \"token_limit\", \"tokens_available\": bucket[\"tokens\"], \"retry_after_seconds\": round(wait, 1)}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {\"allowed\": True, \"tokens_available\": bucket[\"tokens\"]}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def consume(self, user_id, tokens_used, tier=\"free\"):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        bucket = self._get_bucket(user_id, tier)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        bucket[\"tokens\"] -= tokens_used"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        bucket[\"request_timestamps\"].append(time.time())"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        bucket[\"total_tokens_used\"] += tokens_used"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def get_usage(self, user_id):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if user_id not in self.buckets:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            return {\"error\": \"User not found\"}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        b = self.buckets[user_id]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"user_id\": user_id,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"tier\": b[\"tier\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"tokens_remaining\": b[\"tokens\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"capacity\": b[\"capacity\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"total_tokens_used\": b[\"total_tokens_used\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"utilization\": round(b[\"total_tokens_used\"] / b[\"capacity\"], 4) if b[\"capacity\"] else 0,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        }"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 5: Cost Tracker"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Log every call and compute running totals."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class CostTracker:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, monthly_budget=1000.0):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.logs = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.monthly_budget = monthly_budget"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.alerts = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def log_call(self, model, input_tokens, output_tokens, cached_input_tokens=0, latency_ms=0, user_id=\"anonymous\", cache_status=\"miss\"):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        cost = calculate_cost(model, input_tokens, output_tokens, cached_input_tokens)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        entry = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"timestamp\": time.time(),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"model\": model,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"input_tokens\": input_tokens,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"output_tokens\": output_tokens,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"cached_input_tokens\": cached_input_tokens,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"latency_ms\": latency_ms,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"cost\": cost[\"total_cost\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"user_id\": user_id,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"cache_status\": cache_status,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        }"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.logs.append(entry)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self._check_budget()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return entry"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def _check_budget(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        total = self.total_cost()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        pct = total / self.monthly_budget if self.monthly_budget > 0 else 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if pct >= 0.95 and not any(a[\"level\"] == \"stop\" for a in self.alerts):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.alerts.append({\"level\": \"stop\", \"message\": f\"Budget 95% consumed: ${total:.2f}/${self.monthly_budget:.2f}\", \"timestamp\": time.time()})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        elif pct >= 0.85 and not any(a[\"level\"] == \"throttle\" for a in self.alerts):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.alerts.append({\"level\": \"throttle\", \"message\": f\"Budget 85% consumed: ${total:.2f}/${self.monthly_budget:.2f}\", \"timestamp\": time.time()})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        elif pct >= 0.70 and not any(a[\"level\"] == \"warning\" for a in self.alerts):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.alerts.append({\"level\": \"warning\", \"message\": f\"Budget 70% consumed: ${total:.2f}/${self.monthly_budget:.2f}\", \"timestamp\": time.time()})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def total_cost(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return round(sum(e[\"cost\"] for e in self.logs), 6)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def cost_by_model(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        by_model = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for e in self.logs:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            m = e[\"model\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if m not in by_model:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                by_model[m] = {\"calls\": 0, \"cost\": 0, \"input_tokens\": 0, \"output_tokens\": 0}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            by_model[m][\"calls\"] += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            by_model[m][\"cost\"] = round(by_model[m][\"cost\"] + e[\"cost\"], 6)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            by_model[m][\"input_tokens\"] += e[\"input_tokens\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            by_model[m][\"output_tokens\"] += e[\"output_tokens\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return by_model"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def cache_savings(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        cache_hits = [e for e in self.logs if e[\"cache_status\"] == \"hit\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if not cache_hits:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            return {\"saved\": 0, \"cache_hits\": 0}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        saved = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for e in cache_hits:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            full_cost = calculate_cost(e[\"model\"], e[\"input_tokens\"], e[\"output_tokens\"])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            saved += full_cost[\"total_cost\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {\"saved\": round(saved, 4), \"cache_hits\": len(cache_hits)}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def summary(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if not self.logs:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            return {\"total_calls\": 0, \"total_cost\": 0}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        total_latency = sum(e[\"latency_ms\"] for e in self.logs)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        cache_hits = sum(1 for e in self.logs if e[\"cache_status\"] == \"hit\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"total_calls\": len(self.logs),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"total_cost\": self.total_cost(),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"avg_cost_per_call\": round(self.total_cost() / len(self.logs), 6),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"avg_latency_ms\": round(total_latency / len(self.logs), 1),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"cache_hit_rate\": round(cache_hits / len(self.logs), 4),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"cost_by_model\": self.cost_by_model(),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"cache_savings\": self.cache_savings(),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"budget_remaining\": round(self.monthly_budget - self.total_cost(), 2),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"budget_utilization\": round(self.total_cost() / self.monthly_budget, 4) if self.monthly_budget > 0 else 0,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"alerts\": self.alerts,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        }"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 6: Model Router"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Route queries to the cheapest model that can handle them."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "SIMPLE_KEYWORDS = [\"what time\", \"hours\", \"address\", \"phone\", \"price\", \"return policy\", \"hello\", \"hi\", \"thanks\", \"yes\", \"no\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "COMPLEX_KEYWORDS = [\"analyze\", \"compare\", \"explain why\", \"write code\", \"debug\", \"architect\", \"design\", \"trade-off\", \"evaluate\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def classify_complexity(query):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    q = query.lower()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if len(q.split()) <= 5 or any(kw in q for kw in SIMPLE_KEYWORDS):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return \"simple\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if any(kw in q for kw in COMPLEX_KEYWORDS):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return \"complex\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return \"medium\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def route_model(query, tier=\"pro\"):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    complexity = classify_complexity(query)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    routing_table = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"simple\": {\"free\": \"gpt-4.1-nano\", \"pro\": \"gpt-4o-mini\", \"enterprise\": \"gpt-4o-mini\"},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"medium\": {\"free\": \"gpt-4o-mini\", \"pro\": \"claude-sonnet-4\", \"enterprise\": \"claude-sonnet-4\"},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"complex\": {\"free\": \"gpt-4o-mini\", \"pro\": \"gpt-4o\", \"enterprise\": \"claude-opus-4\"},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    }"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    model = routing_table[complexity].get(tier, \"gpt-4o-mini\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return {\"query\": query, \"complexity\": complexity, \"model\": model, \"tier\": tier}"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 7: Run the Demo"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def simulate_llm_call(model, query):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    input_tokens = len(query.split()) * 4 + 500"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    output_tokens = 150 + (len(query.split()) * 2)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    latency = 200 + (output_tokens * 2)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"model\": model,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"response\": f\"[Simulated {model} response to: {query[:50]}...]\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"input_tokens\": input_tokens,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"output_tokens\": output_tokens,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"latency_ms\": latency,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    }"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def run_demo():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(\"=\" * 60)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(\"  Caching, Rate Limiting & Cost Optimization Demo\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(\"=\" * 60)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(\"\\n--- Model Pricing ---\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for model, pricing in list(MODEL_PRICING.items())[:6]:"
      ]
