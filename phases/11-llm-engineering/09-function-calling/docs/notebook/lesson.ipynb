        "        {\"type\": \"object\", \"properties\": {\"code\": {\"type\": \"string\", \"description\": \"Python code to execute\"}, \"language\": {\"type\": \"string\", \"enum\": [\"python\"], \"description\": \"Programming language\"}}, \"required\": [\"code\"]},"
