      "cell_type": "markdown",
      "source": [
        "# WARNING: This sandbox is for demonstrating the tool-call wiring only."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# A determined attacker escapes `__builtins__: {}` in seconds via"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# `(x).__class__.__base__.__subclasses__()`. In production, run user"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# code via one of:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "#   - subprocess.run([\"docker\", \"run\", \"--rm\", \"-i\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "#                       \"--network=none\", \"--read-only\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "#                       \"--memory=256m\", \"--cpus=1.0\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "#                       \"python:3.12-slim\", \"python\", \"-c\", code])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "#   - Firecracker microVM (see Phase 17 lesson on isolation)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "#   - gVisor runsc with seccomp profile"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# The `forbidden` list below is a teaching aid, not a security boundary."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def run_code(code, language=\"python\"):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if language != \"python\":"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {\"error\": True, \"message\": f\"Language '{language}' not supported. Only 'python' is available.\"}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    forbidden = [\"import os\", \"import sys\", \"import subprocess\", \"exec(\", \"eval(\", \"__import__\", \"open(\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for pattern in forbidden:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if pattern in code:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            return {\"error\": True, \"message\": f\"Forbidden operation: {pattern}\", \"code\": \"SECURITY_VIOLATION\"}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    try:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        local_vars = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        exec(code, {\"__builtins__\": {\"print\": print, \"range\": range, \"len\": len, \"str\": str, \"int\": int, \"float\": float, \"list\": list, \"dict\": dict, \"sum\": sum, \"min\": min, \"max\": max, \"abs\": abs, \"round\": round, \"sorted\": sorted, \"enumerate\": enumerate, \"zip\": zip, \"map\": map, \"filter\": filter, \"math\": math}}, local_vars)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        result = local_vars.get(\"result\", None)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {\"success\": True, \"result\": result, \"variables\": {k: str(v) for k, v in local_vars.items() if not k.startswith(\"_\")}}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    except Exception as e:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {\"error\": True, \"message\": f\"{type(e).__name__}: {e}\"}"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
