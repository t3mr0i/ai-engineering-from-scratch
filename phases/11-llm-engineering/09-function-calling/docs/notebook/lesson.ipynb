    {
      "cell_type": "markdown",
      "source": [
        "### Step 4: Build the Function Calling Loop"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "This is the core engine. It simulates the model deciding which tool to call, executes the tool, and feeds results back."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def simulate_model_decision(user_message, tools, conversation_history):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    msg = user_message.lower()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if any(word in msg for word in [\"weather\", \"temperature\", \"forecast\"]):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        cities = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for city in WEATHER_DB:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if city in msg:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                cities.append(city)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if not cities:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for word in msg.split():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                if word.capitalize() in [c.title() for c in WEATHER_DB]:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                    cities.append(word)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if not cities:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            cities = [\"tokyo\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        calls = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for city in cities:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            calls.append({\"name\": \"get_weather\", \"arguments\": {\"city\": city.title()}})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return calls"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if any(word in msg for word in [\"calculate\", \"compute\", \"math\", \"what is\", \"how much\"]):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for token in msg.split():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if any(c in token for c in \"+-*/\"):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                return [{\"name\": \"calculator\", \"arguments\": {\"expression\": token}}]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if \"+\" in msg or \"-\" in msg or \"*\" in msg or \"/\" in msg:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            expr = \"\".join(c for c in msg if c in \"0123456789+-*/.() \")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if expr.strip():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                return [{\"name\": \"calculator\", \"arguments\": {\"expression\": expr.strip()}}]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return [{\"name\": \"calculator\", \"arguments\": {\"expression\": \"0\"}}]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if any(word in msg for word in [\"search\", \"find\", \"look up\", \"google\"]):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        query = msg.replace(\"search for\", \"\").replace(\"look up\", \"\").replace(\"find\", \"\").strip()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return [{\"name\": \"web_search\", \"arguments\": {\"query\": query}}]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if any(word in msg for word in [\"read\", \"file\", \"open\", \"cat\", \"show\"]):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for path in FILE_SYSTEM:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if path.split(\"/\")[-1].split(\".\")[0] in msg:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                return [{\"name\": \"read_file\", \"arguments\": {\"path\": path}}]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return [{\"name\": \"read_file\", \"arguments\": {\"path\": \"README.md\"}}]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if any(word in msg for word in [\"run\", \"execute\", \"code\", \"python\"]):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return [{\"name\": \"run_code\", \"arguments\": {\"code\": \"result = 'Hello from the sandbox!'\", \"language\": \"python\"}}]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def execute_tool_call(tool_call):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    name = tool_call[\"name\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    args = tool_call[\"arguments\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if name not in TOOL_REGISTRY:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {\"error\": True, \"message\": f\"Unknown tool: {name}\", \"code\": \"UNKNOWN_TOOL\"}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    tool = TOOL_REGISTRY[name]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    func = tool[\"function\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    start = time.time()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    try:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        result = func(**args)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    except TypeError as e:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        result = {\"error\": True, \"message\": f\"Invalid arguments: {e}\"}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    elapsed_ms = round((time.time() - start) * 1000, 2)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return {\"tool\": name, \"result\": result, \"execution_time_ms\": elapsed_ms}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def run_function_calling_loop(user_message, max_iterations=5):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    conversation = [{\"role\": \"user\", \"content\": user_message}]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    tool_definitions = [t[\"definition\"] for t in TOOL_REGISTRY.values()]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    all_tool_results = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for iteration in range(max_iterations):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        tool_calls = simulate_model_decision(user_message, tool_definitions, conversation)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if not tool_calls:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            break"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        results = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for call in tool_calls:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            result = execute_tool_call(call)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            results.append(result)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        conversation.append({\"role\": \"assistant\", \"content\": None, \"tool_calls\": tool_calls})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for result in results:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            conversation.append({\"role\": \"tool\", \"content\": json.dumps(result[\"result\"]), \"tool_name\": result[\"tool\"]})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        all_tool_results.extend(results)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        break"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return {\"conversation\": conversation, \"tool_results\": all_tool_results, \"iterations\": iteration + 1 if tool_calls else 0}"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 5: Argument Validation"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Build a validator that checks tool call arguments against the JSON Schema before execution."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def validate_tool_arguments(tool_name, arguments):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if tool_name not in TOOL_REGISTRY:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return [f\"Unknown tool: {tool_name}\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    schema = TOOL_REGISTRY[tool_name][\"definition\"][\"function\"][\"parameters\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    errors = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if not isinstance(arguments, dict):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return [f\"Arguments must be an object, got {type(arguments).__name__}\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for required_field in schema.get(\"required\", []):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if required_field not in arguments:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            errors.append(f\"Missing required argument: {required_field}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    properties = schema.get(\"properties\", {})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for arg_name, arg_value in arguments.items():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if arg_name not in properties:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            errors.append(f\"Unknown argument: {arg_name}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            continue"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        prop_schema = properties[arg_name]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        expected_type = prop_schema.get(\"type\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        type_checks = {\"string\": str, \"integer\": int, \"number\": (int, float), \"boolean\": bool, \"array\": list, \"object\": dict}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if expected_type in type_checks:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if not isinstance(arg_value, type_checks[expected_type]):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                errors.append(f\"Argument '{arg_name}': expected {expected_type}, got {type(arg_value).__name__}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if \"enum\" in prop_schema and arg_value not in prop_schema[\"enum\"]:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            errors.append(f\"Argument '{arg_name}': '{arg_value}' not in {prop_schema['enum']}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return errors"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
