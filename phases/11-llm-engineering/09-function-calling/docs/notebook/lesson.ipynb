      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "TOOL_REGISTRY = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def register_tool(name, description, parameters, function):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    TOOL_REGISTRY[name] = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"definition\": {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"type\": \"function\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"function\": {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"name\": name,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"description\": description,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"parameters\": parameters,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            },"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        },"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"function\": function,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
