      "source": [
        "### Step 2: Implement 5 Tools"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Build a calculator, weather lookup, web search simulator, file reader, and code runner."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def calculator(expression, precision=2):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    allowed = set(\"0123456789+-*/.() \")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if not all(c in allowed for c in expression):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {\"error\": True, \"message\": f\"Invalid characters in expression: {expression}\"}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    try:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        result = eval(expression, {\"__builtins__\": {}}, {\"math\": math})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {\"result\": round(float(result), precision), \"expression\": expression}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    except Exception as e:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {\"error\": True, \"message\": str(e)}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "WEATHER_DB = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"tokyo\": {\"temp_c\": 18, \"condition\": \"cloudy\", \"humidity\": 72, \"wind_kph\": 14},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"new york\": {\"temp_c\": 22, \"condition\": \"sunny\", \"humidity\": 45, \"wind_kph\": 8},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"london\": {\"temp_c\": 12, \"condition\": \"rainy\", \"humidity\": 88, \"wind_kph\": 22},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"san francisco\": {\"temp_c\": 16, \"condition\": \"foggy\", \"humidity\": 80, \"wind_kph\": 18},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"sydney\": {\"temp_c\": 25, \"condition\": \"sunny\", \"humidity\": 55, \"wind_kph\": 10},"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def get_weather(city, units=\"celsius\"):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    key = city.lower().strip()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if key not in WEATHER_DB:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        suggestions = [c for c in WEATHER_DB if c.startswith(key[:3])]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"error\": True,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"message\": f\"City '{city}' not found.\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"suggestions\": suggestions,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"code\": \"CITY_NOT_FOUND\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        }"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    data = WEATHER_DB[key].copy()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if units == \"fahrenheit\":"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        data[\"temp_f\"] = round(data[\"temp_c\"] * 9 / 5 + 32, 1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        del data[\"temp_c\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    data[\"city\"] = city"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return data"
      ]
    },
    {
