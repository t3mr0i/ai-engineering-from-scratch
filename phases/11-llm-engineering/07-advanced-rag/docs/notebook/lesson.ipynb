{
  "cells": [
    {
      "cell_type": "markdown",
      "source": [
        "# Advanced RAG (Chunking, Reranking, Hybrid Search) Notebook\n\n> Hands-on Build It and Exercises."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Build It"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 1: BM25 Implementation"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import math"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "from collections import Counter"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class BM25:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, k1=1.2, b=0.75):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.k1 = k1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.b = b"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.docs = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.doc_lengths = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.avg_dl = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.doc_freqs = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.n_docs = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def index(self, documents):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.docs = documents"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.n_docs = len(documents)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.doc_lengths = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.doc_freqs = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for doc in documents:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            words = doc.lower().split()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.doc_lengths.append(len(words))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            unique_words = set(words)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for word in unique_words:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self.doc_freqs[word] = self.doc_freqs.get(word, 0) + 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.avg_dl = sum(self.doc_lengths) / self.n_docs if self.n_docs else 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def score(self, query, doc_idx):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        query_words = query.lower().split()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        doc_words = self.docs[doc_idx].lower().split()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        doc_len = self.doc_lengths[doc_idx]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        word_counts = Counter(doc_words)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        score = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for term in query_words:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if term not in word_counts:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                continue"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            tf = word_counts[term]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            df = self.doc_freqs.get(term, 0)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            idf = math.log((self.n_docs - df + 0.5) / (df + 0.5) + 1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            numerator = tf * (self.k1 + 1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            denominator = tf + self.k1 * (1 - self.b + self.b * doc_len / self.avg_dl)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            score += idf * numerator / denominator"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return score"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def search(self, query, top_k=10):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        scores = [(i, self.score(query, i)) for i in range(self.n_docs)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        scores.sort(key=lambda x: x[1], reverse=True)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return scores[:top_k]"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 2: Reciprocal Rank Fusion"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def reciprocal_rank_fusion(ranked_lists, k=60):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    scores = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for ranked_list in ranked_lists:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for rank, (doc_id, _) in enumerate(ranked_list):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if doc_id not in scores:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                scores[doc_id] = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            scores[doc_id] += 1.0 / (k + rank + 1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    fused = sorted(scores.items(), key=lambda x: x[1], reverse=True)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return fused"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 3: Hybrid Search Pipeline"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def hybrid_search(query, chunks, vector_embeddings, vocab, idf, bm25_index, top_k=5, fusion_k=60):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    query_emb = tfidf_embed(query, vocab, idf)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    vector_results = search(query_emb, vector_embeddings, top_k=top_k * 3)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    bm25_results = bm25_index.search(query, top_k=top_k * 3)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    fused = reciprocal_rank_fusion([vector_results, bm25_results], k=fusion_k)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return fused[:top_k]"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 4: Simple Reranker"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "In production, you would use a cross-encoder model. Here we build a reranker that scores query-document relevance using word overlap, term importance, and phrase matching."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def rerank(query, candidates, chunks):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    query_words = set(query.lower().split())"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    stop_words = {\"the\", \"a\", \"an\", \"is\", \"are\", \"was\", \"were\", \"what\", \"how\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                  \"why\", \"when\", \"where\", \"do\", \"does\", \"for\", \"of\", \"in\", \"to\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                  \"and\", \"or\", \"on\", \"at\", \"by\", \"it\", \"its\", \"this\", \"that\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                  \"with\", \"from\", \"be\", \"has\", \"have\", \"had\", \"not\", \"but\"}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    query_terms = query_words - stop_words"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    scored = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for doc_id, initial_score in candidates:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        chunk = chunks[doc_id].lower()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        chunk_words = set(chunk.split())"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        term_overlap = len(query_terms & chunk_words)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        query_bigrams = set()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        q_list = [w for w in query.lower().split() if w not in stop_words]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i in range(len(q_list) - 1):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            query_bigrams.add(q_list[i] + \" \" + q_list[i + 1])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        bigram_matches = sum(1 for bg in query_bigrams if bg in chunk)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        position_boost = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for term in query_terms:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            pos = chunk.find(term)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if pos != -1 and pos < len(chunk) // 3:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                position_boost += 0.5"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        rerank_score = ("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            term_overlap * 1.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            + bigram_matches * 2.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            + position_boost"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            + initial_score * 5.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        )"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        scored.append((doc_id, rerank_score))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    scored.sort(key=lambda x: x[1], reverse=True)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return scored"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 5: HyDE (Hypothetical Document Embeddings)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def hyde_generate_hypothesis(query):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    templates = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"what\": \"The answer to '{query}' is as follows: Based on our documentation, {topic} involves specific policies and procedures that define how the process works.\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"how\": \"To address '{query}': The process involves several steps. First, you need to initiate the request. Then, the system processes it according to the defined rules.\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"default\": \"Regarding '{query}': Our records indicate specific details and policies related to this topic that provide a comprehensive answer.\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    }"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    query_lower = query.lower()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if query_lower.startswith(\"what\"):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        template = templates[\"what\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    elif query_lower.startswith(\"how\"):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        template = templates[\"how\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    else:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        template = templates[\"default\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    topic_words = [w for w in query.lower().split()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                   if w not in {\"what\", \"is\", \"the\", \"how\", \"do\", \"does\", \"a\", \"an\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                                \"for\", \"of\", \"to\", \"in\", \"on\", \"at\", \"by\", \"and\", \"or\"}]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    topic = \" \".join(topic_words) if topic_words else \"this topic\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return template.format(query=query, topic=topic)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def hyde_search(query, chunks, vector_embeddings, vocab, idf, top_k=5):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    hypothesis = hyde_generate_hypothesis(query)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    hypothesis_emb = tfidf_embed(hypothesis, vocab, idf)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    results = search(hypothesis_emb, vector_embeddings, top_k)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return results, hypothesis"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 6: Parent-Child Chunking"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def create_parent_child_chunks(text, parent_size=200, child_size=50):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    words = text.split()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    parents = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    children = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    child_to_parent = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    parent_idx = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    start = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    while start < len(words):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        parent_end = min(start + parent_size, len(words))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        parent_text = \" \".join(words[start:parent_end])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        parents.append(parent_text)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        child_start = start"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        while child_start < parent_end:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            child_end = min(child_start + child_size, parent_end)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            child_text = \" \".join(words[child_start:child_end])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            child_idx = len(children)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            children.append(child_text)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            child_to_parent[child_idx] = parent_idx"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            child_start += child_size"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        parent_idx += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        start += parent_size"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return parents, children, child_to_parent"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 7: Faithfulness Evaluation"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def evaluate_faithfulness(answer, retrieved_chunks):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    answer_sentences = [s.strip() for s in answer.split(\".\") if len(s.strip()) > 10]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if not answer_sentences:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return 1.0, []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    grounded = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    ungrounded = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    context = \" \".join(retrieved_chunks).lower()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for sentence in answer_sentences:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        words = set(sentence.lower().split())"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        stop_words = {\"the\", \"a\", \"an\", \"is\", \"are\", \"was\", \"were\", \"and\", \"or\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                      \"to\", \"of\", \"in\", \"for\", \"on\", \"at\", \"by\", \"it\", \"this\", \"that\"}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        content_words = words - stop_words"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if not content_words:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            grounded += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            continue"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        matched = sum(1 for w in content_words if w in context)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        ratio = matched / len(content_words) if content_words else 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if ratio >= 0.5:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            grounded += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        else:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            ungrounded.append(sentence)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    score = grounded / len(answer_sentences) if answer_sentences else 1.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return score, ungrounded"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def evaluate_retrieval_recall(queries_with_relevant, retrieval_fn, k=5):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    total_recall = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    results = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for query, relevant_indices in queries_with_relevant:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        retrieved = retrieval_fn(query, k)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        retrieved_indices = set(idx for idx, _ in retrieved)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        relevant_set = set(relevant_indices)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        hits = len(retrieved_indices & relevant_set)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        recall = hits / len(relevant_set) if relevant_set else 1.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        total_recall += recall"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        results.append({"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"query\": query,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"recall\": recall,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"hits\": hits,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"total_relevant\": len(relevant_set)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        })"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    avg_recall = total_recall / len(queries_with_relevant) if queries_with_relevant else 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return avg_recall, results"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
