      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            ),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            max_output_tokens=512,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        ),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    },"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"code_review\": {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"v1\": PromptTemplate("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            name=\"code_review\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            version=\"v1\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            template=("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"You are a senior software engineer performing a code review. \""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"Identify bugs, security issues, and performance problems. \""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"Be specific. Reference line numbers.\\n\\n\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"Code:\\n```\\n{code}\\n```\\n\\nReview:\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            ),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            model=ModelName.CLAUDE_SONNET,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            max_output_tokens=2048,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        ),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    },"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "AB_EXPERIMENTS = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"general_chat_v2_test\": {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"template\": \"general_chat\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"control\": \"v1\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"variant\": \"v2\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"traffic_pct\": 10,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    },"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def select_prompt(template_name, user_id, variables):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    versions = PROMPT_TEMPLATES.get(template_name)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if not versions:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        raise ValueError(f\"Unknown template: {template_name}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    version = \"v1\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for exp_name, exp in AB_EXPERIMENTS.items():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if exp[\"template\"] == template_name:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            bucket = int(hashlib.md5(f\"{user_id}:{exp_name}\".encode()).hexdigest(), 16) % 100"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if bucket < exp[\"traffic_pct\"]:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                version = exp[\"variant\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            else:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                version = exp[\"control\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            break"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    template = versions.get(version, versions[\"v1\"])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    rendered = template.template.format(**variables)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return template, rendered"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 3: Semantic Cache"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Embedding-based cache that matches semantically similar queries. Two questions phrased differently but meaning the same thing will hit the cache."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def simple_embedding(text, dim=64):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    h = hashlib.sha256(text.lower().strip().encode()).hexdigest()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    raw = [int(h[i:i+2], 16) / 255.0 for i in range(0, min(len(h), dim * 2), 2)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    while len(raw) < dim:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        ext = hashlib.sha256(f\"{text}_{len(raw)}\".encode()).hexdigest()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        raw.extend([int(ext[i:i+2], 16) / 255.0 for i in range(0, min(len(ext), (dim - len(raw)) * 2), 2)])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    raw = raw[:dim]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    norm = math.sqrt(sum(x * x for x in raw))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return [x / norm if norm > 0 else 0.0 for x in raw]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def cosine_similarity(a, b):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    dot = sum(x * y for x, y in zip(a, b))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    norm_a = math.sqrt(sum(x * x for x in a))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    norm_b = math.sqrt(sum(x * x for x in b))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if norm_a == 0 or norm_b == 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return dot / (norm_a * norm_b)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class SemanticCache:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, similarity_threshold=0.92, max_entries=10000, ttl_seconds=3600):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.threshold = similarity_threshold"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.max_entries = max_entries"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.ttl = ttl_seconds"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.entries = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.hits = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.misses = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def get(self, query):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        query_emb = simple_embedding(query)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        now = time.time()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        best_score = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        best_entry = None"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for entry in self.entries:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if now - entry[\"timestamp\"] > self.ttl:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                continue"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            score = cosine_similarity(query_emb, entry[\"embedding\"])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if score > best_score:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                best_score = score"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                best_entry = entry"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if best_entry and best_score >= self.threshold:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.hits += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            return {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"response\": best_entry[\"response\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"similarity\": round(best_score, 4),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"original_query\": best_entry[\"query\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"cached_at\": best_entry[\"timestamp\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            }"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.misses += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return None"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def put(self, query, response):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if len(self.entries) >= self.max_entries:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.entries.sort(key=lambda e: e[\"timestamp\"])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.entries = self.entries[len(self.entries) // 4:]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.entries.append({"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"query\": query,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"embedding\": simple_embedding(query),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"response\": response,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"timestamp\": time.time(),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        })"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def stats(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        total = self.hits + self.misses"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"entries\": len(self.entries),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"hits\": self.hits,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"misses\": self.misses,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"hit_rate_pct\": round(self.hits / max(total, 1) * 100, 2),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        }"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 4: Guardrails"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Input validation catches prompt injection and PII before the LLM sees it. Output validation catches unsafe content before the user sees it. Two walls. Nothing passes unchecked."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "INJECTION_PATTERNS = ["
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    r\"ignore\\s+(all\\s+)?previous\\s+instructions\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    r\"ignore\\s+(all\\s+)?above\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    r\"you\\s+are\\s+now\\s+DAN\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    r\"system\\s*:\\s*override\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    r\"<\\s*system\\s*>\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    r\"jailbreak\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    r\"\\bpretend\\s+you\\s+have\\s+no\\s+(restrictions|rules|guidelines)\\b\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "PII_PATTERNS = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"ssn\": r\"\\b\\d{3}-\\d{2}-\\d{4}\\b\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"credit_card\": r\"\\b\\d{4}[\\s-]?\\d{4}[\\s-]?\\d{4}[\\s-]?\\d{4}\\b\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"email\": r\"\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"phone\": r\"\\b\\d{3}[-.]?\\d{3}[-.]?\\d{4}\\b\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "BANNED_OUTPUT_PATTERNS = ["
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    r\"(?i)(DROP|DELETE|TRUNCATE)\\s+TABLE\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    r\"(?i)rm\\s+-rf\\s+/\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    r\"(?i)(sudo\\s+)?(chmod|chown)\\s+777\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    r\"(?i)exec\\s*\\(\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    r\"(?i)__import__\\s*\\(\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "@dataclass"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class GuardrailResult:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    passed: bool"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    blocked_reason: str | None = None"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    pii_detected: list = field(default_factory=list)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    modified_text: str | None = None"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def check_input_guardrails(text):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for pattern in INJECTION_PATTERNS:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if re.search(pattern, text, re.IGNORECASE):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            return GuardrailResult("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                passed=False,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                blocked_reason=f\"Potential prompt injection detected\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            )"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    pii_found = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for pii_type, pattern in PII_PATTERNS.items():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if re.search(pattern, text):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            pii_found.append(pii_type)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if pii_found:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        redacted = text"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for pii_type, pattern in PII_PATTERNS.items():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            redacted = re.sub(pattern, f\"[REDACTED_{pii_type.upper()}]\", redacted)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return GuardrailResult("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            passed=True,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            pii_detected=pii_found,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            modified_text=redacted,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        )"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return GuardrailResult(passed=True)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def check_output_guardrails(text):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for pattern in BANNED_OUTPUT_PATTERNS:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if re.search(pattern, text):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            return GuardrailResult("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                passed=False,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                blocked_reason=\"Response contained potentially unsafe content\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            )"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return GuardrailResult(passed=True)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 5: LLM Caller with Retry and Streaming"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "The core LLM interface. Exponential backoff with jitter on failures. Fallback through the model chain. Streaming support for token-by-token delivery."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def estimate_tokens(text):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return max(1, len(text.split()) * 4 // 3)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def calculate_cost(model, input_tokens, output_tokens):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    pricing = MODEL_PRICING.get(model, MODEL_PRICING[ModelName.GPT_4O])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    input_cost = input_tokens / 1_000_000 * pricing[\"input\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    output_cost = output_tokens / 1_000_000 * pricing[\"output\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return round(input_cost + output_cost, 8)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "SIMULATED_RESPONSES = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"general\": \"Based on the information available, here is a clear and concise answer to your question. \""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "               \"The key points are: first, the fundamental concept involves understanding the relationship \""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "               \"between the components. Second, practical implementation requires attention to error handling \""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "               \"and edge cases. Third, performance optimization comes from measuring before optimizing. \""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "               \"Let me know if you need more detail on any specific aspect.\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"rag\": \"According to the provided context, the answer is as follows. The documentation states that \""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "           \"the system processes requests through a pipeline of validation, transformation, and execution stages. \""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "           \"Each stage can be configured independently. The context specifically mentions that caching reduces \""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "           \"latency by 40-60% for repeated queries.\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"code_review\": \"Code Review Findings:\\n\\n\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                   \"1. Line 12: SQL query uses string concatenation instead of parameterized queries. \""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                   \"This is a SQL injection vulnerability. Use prepared statements.\\n\\n\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                   \"2. Line 28: The try/except block catches all exceptions silently. \""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                   \"Log the exception and re-raise or handle specific exception types.\\n\\n\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                   \"3. Line 45: No input validation on user_id parameter. \""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                   \"Validate that it matches the expected UUID format before database lookup.\\n\\n\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                   \"4. Performance: The loop on line 33-40 makes a database query per iteration. \""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                   \"Batch the queries into a single SELECT with an IN clause.\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "async def call_llm_with_retry(prompt, model, max_retries=3):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for attempt in range(max_retries + 1):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        try:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            failure_chance = 0.15 if attempt == 0 else 0.05"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if random.random() < failure_chance:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                raise ConnectionError(f\"API error from {model.value}: 500 Internal Server Error\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            await asyncio.sleep(random.uniform(0.1, 0.3))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if \"code\" in prompt.lower() or \"review\" in prompt.lower():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                response_text = SIMULATED_RESPONSES[\"code_review\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            elif \"context\" in prompt.lower():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                response_text = SIMULATED_RESPONSES[\"rag\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            else:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                response_text = SIMULATED_RESPONSES[\"general\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            return {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"text\": response_text,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"model\": model.value,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"input_tokens\": estimate_tokens(prompt),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"output_tokens\": estimate_tokens(response_text),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            }"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        except (ConnectionError, TimeoutError) as e:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if attempt < max_retries:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                backoff = min(2 ** attempt + random.uniform(0, 1), 10)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                await asyncio.sleep(backoff)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            else:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                raise"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    raise ConnectionError(f\"All {max_retries} retries exhausted for {model.value}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "async def call_with_fallback(prompt, preferred_model=None):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    chain = list(FALLBACK_CHAIN)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if preferred_model and preferred_model in chain:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        chain.remove(preferred_model)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        chain.insert(0, preferred_model)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    last_error = None"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for model in chain:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        try:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            return await call_llm_with_retry(prompt, model)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        except ConnectionError as e:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            last_error = e"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            continue"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"text\": \"I apologize, but I am temporarily unable to process your request. Please try again in a moment.\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"model\": \"fallback\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"input_tokens\": estimate_tokens(prompt),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"output_tokens\": 20,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"error\": str(last_error),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    }"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "async def stream_response(text):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    words = text.split()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for i, word in enumerate(words):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        token = word if i == 0 else \" \" + word"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        yield token"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        await asyncio.sleep(random.uniform(0.02, 0.08))"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 6: The Request Pipeline"
