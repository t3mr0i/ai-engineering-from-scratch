      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "@dataclass"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class PromptTemplate:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    name: str"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    version: str"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    template: str"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    model: ModelName = ModelName.GPT_4O"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    max_output_tokens: int = 1024"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "PROMPT_TEMPLATES = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"general_chat\": {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"v1\": PromptTemplate("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            name=\"general_chat\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            version=\"v1\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            template=("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"You are a helpful AI assistant. Answer the user's question clearly and concisely.\\n\\n\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"User question: {query}\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            ),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        ),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"v2\": PromptTemplate("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            name=\"general_chat\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            version=\"v2\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            template=("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"You are an AI assistant that gives precise, actionable answers. \""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"If you are unsure, say so. Never fabricate information.\\n\\n\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                \"Question: {query}\\n\\nAnswer:\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            ),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        ),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    },"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"rag_answer\": {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"v1\": PromptTemplate("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            name=\"rag_answer\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            version=\"v1\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
