      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    details: str"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    confidence: float"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
