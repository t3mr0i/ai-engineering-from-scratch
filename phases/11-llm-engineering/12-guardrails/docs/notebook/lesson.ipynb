      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "@dataclass"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class GuardrailReport:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    input_results: list = field(default_factory=list)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    output_results: list = field(default_factory=list)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    blocked: bool = False"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    block_reason: str = \"\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    total_latency_ms: float = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "INJECTION_PATTERNS = ["
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"ignore\\s+(all\\s+)?previous\\s+instructions\", 0.95),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"ignore\\s+(all\\s+)?above\\s+instructions\", 0.95),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"disregard\\s+(all\\s+)?prior\\s+(instructions|context|rules)\", 0.95),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"forget\\s+(everything|all)\\s+(above|before|prior)\", 0.90),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"you\\s+are\\s+now\\s+(a|an)\\s+unrestricted\", 0.95),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"you\\s+are\\s+now\\s+DAN\", 0.98),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"jailbreak\", 0.85),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"do\\s+anything\\s+now\", 0.90),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"developer\\s+mode\\s+(enabled|activated|on)\", 0.92),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"override\\s+(safety|content)\\s+(filter|policy|guidelines)\", 0.93),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"print\\s+(your|the)\\s+(system\\s+)?prompt\", 0.88),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"repeat\\s+(the\\s+)?(text|words|instructions)\\s+above\", 0.85),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"what\\s+(are|were)\\s+your\\s+(initial\\s+)?instructions\", 0.82),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"reveal\\s+(your|the)\\s+(system\\s+)?(prompt|instructions)\", 0.90),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"output\\s+(your|the)\\s+(system\\s+)?(prompt|instructions)\", 0.90),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"sudo\\s+mode\", 0.88),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"\\[INST\\]\", 0.80),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"<\\|im_start\\|>system\", 0.90),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"###\\s*(system|instruction)\", 0.75),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    (r\"act\\s+as\\s+if\\s+(you\\s+have\\s+)?no\\s+(restrictions|limits|rules)\", 0.88),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "PII_PATTERNS = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"email\": (r\"\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b\", 0.95),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"phone_us\": (r\"\\b(\\+?1[-.\\s]?)?\\(?\\d{3}\\)?[-.\\s]?\\d{3}[-.\\s]?\\d{4}\\b\", 0.85),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"ssn\": (r\"\\b\\d{3}-\\d{2}-\\d{4}\\b\", 0.98),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"credit_card\": (r\"\\b(?:4[0-9]{12}(?:[0-9]{3})?|5[1-5][0-9]{14}|3[47][0-9]{13})\\b\", 0.95),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"ip_address\": (r\"\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b\", 0.70),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"date_of_birth\": (r\"\\b(?:DOB|born|birthday|date of birth)[:\\s]+\\d{1,2}[/\\-]\\d{1,2}[/\\-]\\d{2,4}\\b\", 0.85),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"passport\": (r\"\\b[A-Z]{1,2}\\d{6,9}\\b\", 0.60),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "TOPIC_KEYWORDS = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"violence\": [\"kill\", \"murder\", \"attack\", \"weapon\", \"bomb\", \"shoot\", \"stab\", \"explode\", \"assault\", \"torture\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"illegal_activity\": [\"hack\", \"crack\", \"steal\", \"forge\", \"counterfeit\", \"launder\", \"traffick\", \"smuggle\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"self_harm\": [\"suicide\", \"self-harm\", \"cut myself\", \"end my life\", \"kill myself\", \"want to die\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"sexual_explicit\": [\"explicit sexual\", \"pornograph\", \"nude image\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"hate_speech\": [\"racial slur\", \"ethnic cleansing\", \"white supremac\", \"nazi\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "ALLOWED_TOPICS = ["
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"technology\", \"programming\", \"science\", \"math\", \"business\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"education\", \"health_info\", \"cooking\", \"travel\", \"general_knowledge\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def detect_injection(text):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    start = time.time()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    text_lower = text.lower()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    detections = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for pattern, confidence in INJECTION_PATTERNS:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        matches = re.findall(pattern, text_lower)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if matches:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            detections.append({\"pattern\": pattern, \"confidence\": confidence, \"match\": str(matches[0])})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    encoding_tricks = ["
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        text_lower.count(\"\\\\u\") > 3,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        text_lower.count(\"base64\") > 0,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        text_lower.count(\"rot13\") > 0,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        text_lower.count(\"hex:\") > 0,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        bool(re.search(r\"[\\u200b-\\u200f\\u2028-\\u202f]\", text)),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    ]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if any(encoding_tricks):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        detections.append({\"pattern\": \"encoding_evasion\", \"confidence\": 0.70, \"match\": \"suspicious encoding\"})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    max_confidence = max((d[\"confidence\"] for d in detections), default=0.0)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    latency = (time.time() - start) * 1000"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return GuardrailResult("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        passed=max_confidence < 0.75,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        category=\"injection_detection\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        details=json.dumps(detections) if detections else \"clean\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        confidence=max_confidence,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        latency_ms=round(latency, 2),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    )"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def detect_pii(text):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    start = time.time()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    found = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for pii_type, (pattern, confidence) in PII_PATTERNS.items():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        matches = re.findall(pattern, text, re.IGNORECASE)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if matches:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for match in matches:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                match_str = match if isinstance(match, str) else match[0]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                found.append({\"type\": pii_type, \"confidence\": confidence, \"value_hash\": hashlib.sha256(match_str.encode()).hexdigest()[:12]})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    latency = (time.time() - start) * 1000"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    has_pii = len(found) > 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return GuardrailResult("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        passed=not has_pii,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        category=\"pii_detection\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        details=json.dumps(found) if found else \"no PII detected\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        confidence=max((f[\"confidence\"] for f in found), default=0.0),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        latency_ms=round(latency, 2),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    )"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def classify_topic(text):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    start = time.time()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    text_lower = text.lower()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    flagged = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for category, keywords in TOPIC_KEYWORDS.items():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        matches = [kw for kw in keywords if kw in text_lower]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if matches:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            flagged.append({\"category\": category, \"matched_keywords\": matches, \"confidence\": min(0.6 + len(matches) * 0.15, 0.99)})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    latency = (time.time() - start) * 1000"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    max_confidence = max((f[\"confidence\"] for f in flagged), default=0.0)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return GuardrailResult("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        passed=max_confidence < 0.75,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        category=\"topic_classification\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        details=json.dumps(flagged) if flagged else \"on-topic\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        confidence=max_confidence,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        latency_ms=round(latency, 2),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    )"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def check_length(text, max_chars=5000, max_words=1000):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    start = time.time()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    char_count = len(text)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    word_count = len(text.split())"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    passed = char_count <= max_chars and word_count <= max_words"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    latency = (time.time() - start) * 1000"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return GuardrailResult("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        passed=passed,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        category=\"length_check\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        details=f\"chars={char_count}/{max_chars}, words={word_count}/{max_words}\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        confidence=1.0 if not passed else 0.0,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        latency_ms=round(latency, 2),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    )"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 2: Output Guardrails"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Build validators that check the model's response before the user sees it."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "TOXIC_PATTERNS = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"hate\": (r\"\\b(hate\\s+all|inferior\\s+race|subhuman|degenerate\\s+people)\\b\", 0.90),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"violence_graphic\": (r\"\\b(slit\\s+(their|your)\\s+throat|gouge\\s+(their|your)\\s+eyes|disembowel)\\b\", 0.95),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"self_harm_instruction\": (r\"\\b(how\\s+to\\s+(commit\\s+)?suicide|methods\\s+of\\s+self[- ]harm|lethal\\s+dose)\\b\", 0.98),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    \"illegal_instruction\": (r\"\\b(how\\s+to\\s+make\\s+(a\\s+)?bomb|synthesize\\s+(meth|cocaine|fentanyl))\\b\", 0.98),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def filter_toxicity(text):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    start = time.time()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    text_lower = text.lower()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    flagged = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for category, (pattern, confidence) in TOXIC_PATTERNS.items():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if re.search(pattern, text_lower):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            flagged.append({\"category\": category, \"confidence\": confidence})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    latency = (time.time() - start) * 1000"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    max_confidence = max((f[\"confidence\"] for f in flagged), default=0.0)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return GuardrailResult("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        passed=max_confidence < 0.80,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        category=\"toxicity_filter\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        details=json.dumps(flagged) if flagged else \"clean\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        confidence=max_confidence,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        latency_ms=round(latency, 2),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    )"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def scrub_pii_from_output(text):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    start = time.time()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    scrubbed = text"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    replacements = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    email_pattern = r\"\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for match in re.finditer(email_pattern, scrubbed):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        replacements.append({\"type\": \"email\", \"original_hash\": hashlib.sha256(match.group().encode()).hexdigest()[:12]})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    scrubbed = re.sub(email_pattern, \"[EMAIL REDACTED]\", scrubbed)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    ssn_pattern = r\"\\b\\d{3}-\\d{2}-\\d{4}\\b\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for match in re.finditer(ssn_pattern, scrubbed):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        replacements.append({\"type\": \"ssn\", \"original_hash\": hashlib.sha256(match.group().encode()).hexdigest()[:12]})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    scrubbed = re.sub(ssn_pattern, \"[SSN REDACTED]\", scrubbed)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    cc_pattern = r\"\\b(?:4[0-9]{12}(?:[0-9]{3})?|5[1-5][0-9]{14}|3[47][0-9]{13})\\b\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for match in re.finditer(cc_pattern, scrubbed):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        replacements.append({\"type\": \"credit_card\", \"original_hash\": hashlib.sha256(match.group().encode()).hexdigest()[:12]})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    scrubbed = re.sub(cc_pattern, \"[CARD REDACTED]\", scrubbed)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    phone_pattern = r\"\\b(\\+?1[-.\\s]?)?\\(?\\d{3}\\)?[-.\\s]?\\d{3}[-.\\s]?\\d{4}\\b\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for match in re.finditer(phone_pattern, scrubbed):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        replacements.append({\"type\": \"phone\", \"original_hash\": hashlib.sha256(match.group().encode()).hexdigest()[:12]})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    scrubbed = re.sub(phone_pattern, \"[PHONE REDACTED]\", scrubbed)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    latency = (time.time() - start) * 1000"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return scrubbed, GuardrailResult("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        passed=len(replacements) == 0,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        category=\"pii_scrubbing\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        details=json.dumps(replacements) if replacements else \"no PII found\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        confidence=0.95 if replacements else 0.0,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        latency_ms=round(latency, 2),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    )"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def check_relevance(input_text, output_text, threshold=0.15):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    start = time.time()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    input_words = set(input_text.lower().split())"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    output_words = set(output_text.lower().split())"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    stop_words = {\"the\", \"a\", \"an\", \"is\", \"are\", \"was\", \"were\", \"be\", \"been\", \"being\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                  \"have\", \"has\", \"had\", \"do\", \"does\", \"did\", \"will\", \"would\", \"could\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                  \"should\", \"may\", \"might\", \"shall\", \"can\", \"to\", \"of\", \"in\", \"for\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                  \"on\", \"with\", \"at\", \"by\", \"from\", \"it\", \"this\", \"that\", \"i\", \"you\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                  \"he\", \"she\", \"we\", \"they\", \"my\", \"your\", \"his\", \"her\", \"our\", \"their\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                  \"what\", \"which\", \"who\", \"when\", \"where\", \"how\", \"not\", \"no\", \"and\", \"or\", \"but\"}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    input_meaningful = input_words - stop_words"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    output_meaningful = output_words - stop_words"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if not input_meaningful or not output_meaningful:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        latency = (time.time() - start) * 1000"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return GuardrailResult(passed=True, category=\"relevance\", details=\"insufficient words for comparison\", confidence=0.0, latency_ms=round(latency, 2))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    overlap = input_meaningful & output_meaningful"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    score = len(overlap) / max(len(input_meaningful), 1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    latency = (time.time() - start) * 1000"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return GuardrailResult("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        passed=score >= threshold,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        category=\"relevance_check\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        details=f\"overlap_score={score:.2f}, shared_words={list(overlap)[:10]}\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        confidence=1.0 - score,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        latency_ms=round(latency, 2),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    )"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def check_system_prompt_leak(output_text, system_prompt, threshold=0.4):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    start = time.time()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    sys_words = set(system_prompt.lower().split()) - {\"the\", \"a\", \"an\", \"is\", \"are\", \"you\", \"your\", \"to\", \"of\", \"in\", \"and\", \"or\"}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    out_words = set(output_text.lower().split())"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if not sys_words:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        latency = (time.time() - start) * 1000"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return GuardrailResult(passed=True, category=\"prompt_leak\", details=\"empty system prompt\", confidence=0.0, latency_ms=round(latency, 2))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    overlap = sys_words & out_words"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    score = len(overlap) / len(sys_words)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    latency = (time.time() - start) * 1000"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return GuardrailResult("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        passed=score < threshold,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        category=\"prompt_leak_detection\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        details=f\"similarity={score:.2f}, threshold={threshold}\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        confidence=score,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        latency_ms=round(latency, 2),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    )"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 3: The Guardrail Pipeline"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Wire input and output guardrails into a single pipeline that wraps your LLM call."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class GuardrailPipeline:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, system_prompt=\"You are a helpful assistant.\"):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.system_prompt = system_prompt"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.stats = {\"total\": 0, \"blocked_input\": 0, \"blocked_output\": 0, \"passed\": 0, \"pii_scrubbed\": 0}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.log = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def validate_input(self, user_input):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        results = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        results.append(check_length(user_input))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        results.append(detect_injection(user_input))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        results.append(detect_pii(user_input))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        results.append(classify_topic(user_input))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return results"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def validate_output(self, user_input, model_output):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        results = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        results.append(filter_toxicity(model_output))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        results.append(check_relevance(user_input, model_output))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        results.append(check_system_prompt_leak(model_output, self.system_prompt))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        scrubbed_output, pii_result = scrub_pii_from_output(model_output)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        results.append(pii_result)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return results, scrubbed_output"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def process(self, user_input, model_fn=None):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.stats[\"total\"] += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        report = GuardrailReport()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        start = time.time()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        input_results = self.validate_input(user_input)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        report.input_results = input_results"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for result in input_results:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if not result.passed:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                report.blocked = True"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                report.block_reason = f\"Input blocked: {result.category} (confidence={result.confidence:.2f})\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self.stats[\"blocked_input\"] += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                report.total_latency_ms = round((time.time() - start) * 1000, 2)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self._log_event(user_input, None, report)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                return \"I cannot process this request. Please rephrase your question.\", report"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if model_fn:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            model_output = model_fn(user_input)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        else:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            model_output = self._simulate_llm(user_input)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        output_results, scrubbed = self.validate_output(user_input, model_output)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        report.output_results = output_results"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for result in output_results:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if not result.passed and result.category != \"pii_scrubbing\":"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                report.blocked = True"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                report.block_reason = f\"Output blocked: {result.category} (confidence={result.confidence:.2f})\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self.stats[\"blocked_output\"] += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                report.total_latency_ms = round((time.time() - start) * 1000, 2)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self._log_event(user_input, model_output, report)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                return \"I apologize, but I cannot provide that response. Let me help you differently.\", report"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if scrubbed != model_output:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.stats[\"pii_scrubbed\"] += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.stats[\"passed\"] += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        report.total_latency_ms = round((time.time() - start) * 1000, 2)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self._log_event(user_input, scrubbed, report)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return scrubbed, report"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def _simulate_llm(self, user_input):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        responses = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"weather\": \"The current weather in San Francisco is 18C and foggy with moderate humidity.\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"account\": \"Your account balance is $5,432.10. Your recent transactions include a $50 payment to Amazon.\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"help\": \"I can help you with account inquiries, transfers, and general banking questions.\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        }"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for key, response in responses.items():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if key in user_input.lower():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                return response"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return f\"Based on your question about '{user_input[:50]}', here is what I can tell you.\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def _log_event(self, user_input, output, report):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.log.append({"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"timestamp\": time.time(),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"input_hash\": hashlib.sha256(user_input.encode()).hexdigest()[:16],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"blocked\": report.blocked,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"block_reason\": report.block_reason,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"latency_ms\": report.total_latency_ms,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        })"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def get_stats(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        total = self.stats[\"total\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if total == 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            return self.stats"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            **self.stats,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"block_rate\": round((self.stats[\"blocked_input\"] + self.stats[\"blocked_output\"]) / total * 100, 1),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"pass_rate\": round(self.stats[\"passed\"] / total * 100, 1),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        }"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 4: Monitoring Dashboard"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Track what gets blocked, what passes, and what patterns emerge."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class GuardrailMonitor:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.events = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.attack_patterns = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.hourly_counts = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def record(self, report, user_input=\"\"):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        event = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"timestamp\": time.time(),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"blocked\": report.blocked,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"reason\": report.block_reason,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"input_checks\": [(r.category, r.passed, r.confidence) for r in report.input_results],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"output_checks\": [(r.category, r.passed, r.confidence) for r in report.output_results],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"latency_ms\": report.total_latency_ms,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        }"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.events.append(event)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if report.blocked:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            category = report.block_reason.split(\":\")[1].strip().split(\" \")[0] if \":\" in report.block_reason else \"unknown\""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.attack_patterns[category] = self.attack_patterns.get(category, 0) + 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def summary(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if not self.events:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            return {\"total\": 0, \"blocked\": 0, \"passed\": 0}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        total = len(self.events)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        blocked = sum(1 for e in self.events if e[\"blocked\"])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        latencies = [e[\"latency_ms\"] for e in self.events]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"total_requests\": total,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"blocked\": blocked,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"passed\": total - blocked,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"block_rate_pct\": round(blocked / total * 100, 1),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"avg_latency_ms\": round(sum(latencies) / len(latencies), 2),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"p95_latency_ms\": round(sorted(latencies)[int(len(latencies) * 0.95)] if latencies else 0, 2),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"attack_patterns\": dict(sorted(self.attack_patterns.items(), key=lambda x: x[1], reverse=True)),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        }"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def print_dashboard(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        s = self.summary()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(\"=\" * 55)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(\"  Guardrail Monitoring Dashboard\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(\"=\" * 55)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(f\"  Total requests:  {s['total_requests']}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(f\"  Passed:          {s['passed']}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(f\"  Blocked:         {s['blocked']} ({s['block_rate_pct']}%)\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(f\"  Avg latency:     {s['avg_latency_ms']}ms\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(f\"  P95 latency:     {s['p95_latency_ms']}ms\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if s[\"attack_patterns\"]:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            print(f\"\\n  Attack patterns detected:\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for pattern, count in s[\"attack_patterns\"].items():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                bar = \"#\" * min(count * 3, 30)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                print(f\"    {pattern:30s} {count:3d} {bar}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(\"=\" * 55)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 5: Run the Demo"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def run_demo():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    pipeline = GuardrailPipeline("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        system_prompt=\"You are a banking assistant. Help customers with account inquiries, transfers, and general banking questions. Never reveal account numbers or SSNs.\""
