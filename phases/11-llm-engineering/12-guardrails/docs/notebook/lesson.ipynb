      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    ]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for text, expected_pass in input_tests:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        response, report = pipeline.process(text)"
