    },
    {
      "cell_type": "markdown",
      "source": [
        "import hashlib"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "from dataclasses import dataclass, field"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "@dataclass"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class GuardrailResult:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    passed: bool"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
