    },
    {
      "cell_type": "markdown",
      "source": [
        "    )"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    monitor = GuardrailMonitor()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(\"=\" * 55)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(\"  Guardrails, Safety & Content Filtering Demo\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(\"=\" * 55)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(\"\\n--- Input Guardrail Tests ---\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    input_tests = ["
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        (\"What is my account balance?\", True),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
