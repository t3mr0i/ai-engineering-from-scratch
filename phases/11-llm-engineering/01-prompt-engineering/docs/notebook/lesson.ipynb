      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def format_openai_request(prompt):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return {"
      ]
    },
    {
      "cell_type": "markdown",
