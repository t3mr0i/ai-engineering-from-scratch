      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    }"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return simulated_responses.get(model_name, {\"response\": \"Unknown model\", \"tokens_used\": {}, \"latency_ms\": 0})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def run_prompt_test(prompt, models=None):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if models is None:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        models = list(MODEL_CONFIGS.keys())"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    results = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for model_name in models:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        config = MODEL_CONFIGS[model_name]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        formatter = FORMATTERS[config[\"provider\"]]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        request = formatter(prompt)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        start = time.time()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        response = simulate_llm_call(model_name, request)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        wall_time = (time.time() - start) * 1000"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        results[model_name] = {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"response\": response[\"response\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"tokens\": response[\"tokens_used\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"api_latency_ms\": response[\"latency_ms\"],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"wall_time_ms\": round(wall_time, 1),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            \"finish_reason\": response.get(\"finish_reason\"),"
      ]
    },
