      "source": [
        "    \"claude-3.5-sonnet\": {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"provider\": \"anthropic\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"model\": \"claude-3-5-sonnet-20241022\","
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"max_tokens\": 2048,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"context_window\": 200_000,"
