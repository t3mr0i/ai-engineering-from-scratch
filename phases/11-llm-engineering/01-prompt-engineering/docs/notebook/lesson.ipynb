    },
    {
      "cell_type": "markdown",
      "source": [
        "    }"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def format_anthropic_request(prompt):"
