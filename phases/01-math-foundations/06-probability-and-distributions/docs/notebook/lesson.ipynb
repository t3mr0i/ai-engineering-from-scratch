  "cells": [
    {
      "cell_type": "markdown",
      "source": [
        "# Probability and Distributions Notebook\n\n> Hands-on Build It and Exercises."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Build It"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 1: Probability basics"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import math"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import random"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def factorial(n):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    result = 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for i in range(2, n + 1):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        result *= i"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return result"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def combinations(n, k):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return factorial(n) // (factorial(k) * factorial(n - k))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def conditional_probability(p_a_and_b, p_b):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return p_a_and_b / p_b"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "p_king_given_face = conditional_probability(4/52, 12/52)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"P(King | Face card) = {p_king_given_face:.4f}\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 2: PMF and PDF from scratch"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def bernoulli_pmf(k, p):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return p if k == 1 else (1 - p)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def categorical_pmf(k, probs):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return probs[k]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def poisson_pmf(k, lam):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return (lam ** k) * math.exp(-lam) / factorial(k)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def uniform_pdf(x, a, b):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if a <= x <= b:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return 1.0 / (b - a)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def normal_pdf(x, mu, sigma):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    coeff = 1.0 / (sigma * math.sqrt(2 * math.pi))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    exponent = -0.5 * ((x - mu) / sigma) ** 2"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return coeff * math.exp(exponent)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 3: Expected value and variance"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def expected_value(values, probabilities):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return sum(v * p for v, p in zip(values, probabilities))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def variance(values, probabilities):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    mu = expected_value(values, probabilities)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return sum(p * (v - mu) ** 2 for v, p in zip(values, probabilities))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "die_values = [1, 2, 3, 4, 5, 6]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "die_probs = [1/6] * 6"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "mu = expected_value(die_values, die_probs)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "var = variance(die_values, die_probs)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"Die: E[X] = {mu:.4f}, Var(X) = {var:.4f}, SD = {var**0.5:.4f}\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 4: Sampling from distributions"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def sample_bernoulli(p, n=1):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return [1 if random.random() < p else 0 for _ in range(n)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def sample_categorical(probs, n=1):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    cumulative = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    total = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for p in probs:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        total += p"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        cumulative.append(total)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    samples = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for _ in range(n):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        r = random.random()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i, c in enumerate(cumulative):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if r <= c:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                samples.append(i)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                break"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return samples"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def sample_normal_box_muller(mu, sigma, n=1):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    samples = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for _ in range(n):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        u1 = random.random()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        u2 = random.random()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        z = math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * u2)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        samples.append(mu + sigma * z)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return samples"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 5: Softmax and log probabilities"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def softmax(logits):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    max_logit = max(logits)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    shifted = [z - max_logit for z in logits]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    exps = [math.exp(z) for z in shifted]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    total = sum(exps)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return [e / total for e in exps]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def log_softmax(logits):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    max_logit = max(logits)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    shifted = [z - max_logit for z in logits]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    log_sum_exp = max_logit + math.log(sum(math.exp(z) for z in shifted))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return [z - log_sum_exp for z in logits]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def cross_entropy_loss(logits, target_index):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    log_probs = log_softmax(logits)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return -log_probs[target_index]"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 6: Central Limit Theorem demonstration"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def demonstrate_clt(dist_fn, n_samples, n_averages):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    averages = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for _ in range(n_averages):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        samples = [dist_fn() for _ in range(n_samples)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        averages.append(sum(samples) / len(samples))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return averages"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
