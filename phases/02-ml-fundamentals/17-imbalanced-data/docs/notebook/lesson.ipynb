{
  "cells": [
    {
      "cell_type": "markdown",
      "source": [
        "# Handling Imbalanced Data Notebook\n\n> Hands-on Build It and Exercises."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Build It"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 1: Generate an imbalanced dataset"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import numpy as np"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def make_imbalanced_data(n_majority=950, n_minority=50, seed=42):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    rng = np.random.RandomState(seed)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    X_maj = rng.randn(n_majority, 2) * 1.0 + np.array([0.0, 0.0])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    X_min = rng.randn(n_minority, 2) * 0.8 + np.array([2.5, 2.5])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    X = np.vstack([X_maj, X_min])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    y = np.concatenate([np.zeros(n_majority), np.ones(n_minority)])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    shuffle_idx = rng.permutation(len(y))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return X[shuffle_idx], y[shuffle_idx]"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 2: SMOTE from scratch"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def euclidean_distance(a, b):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return np.sqrt(np.sum((a - b) ** 2))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def find_k_neighbors(X, idx, k):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    distances = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for i in range(len(X)):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if i == idx:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            continue"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        d = euclidean_distance(X[idx], X[i])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        distances.append((i, d))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    distances.sort(key=lambda x: x[1])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return [d[0] for d in distances[:k]]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def smote(X_minority, k=5, n_synthetic=100, seed=42):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    rng = np.random.RandomState(seed)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    n_samples = len(X_minority)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    k = min(k, n_samples - 1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    synthetic = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for _ in range(n_synthetic):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        idx = rng.randint(0, n_samples)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        neighbors = find_k_neighbors(X_minority, idx, k)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        neighbor_idx = neighbors[rng.randint(0, len(neighbors))]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        t = rng.random()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        new_point = X_minority[idx] + t * (X_minority[neighbor_idx] - X_minority[idx])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        synthetic.append(new_point)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return np.array(synthetic)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 3: Random oversampling and undersampling"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def random_oversample(X, y, seed=42):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    rng = np.random.RandomState(seed)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    classes, counts = np.unique(y, return_counts=True)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    max_count = counts.max()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    X_resampled = list(X)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    y_resampled = list(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for cls, count in zip(classes, counts):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if count < max_count:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            cls_indices = np.where(y == cls)[0]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            n_needed = max_count - count"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            chosen = rng.choice(cls_indices, size=n_needed, replace=True)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            X_resampled.extend(X[chosen])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            y_resampled.extend(y[chosen])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    X_out = np.array(X_resampled)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    y_out = np.array(y_resampled)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    shuffle = rng.permutation(len(y_out))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return X_out[shuffle], y_out[shuffle]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def random_undersample(X, y, seed=42):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    rng = np.random.RandomState(seed)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    classes, counts = np.unique(y, return_counts=True)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    min_count = counts.min()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    X_resampled = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    y_resampled = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for cls in classes:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        cls_indices = np.where(y == cls)[0]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        chosen = rng.choice(cls_indices, size=min_count, replace=False)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        X_resampled.extend(X[chosen])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        y_resampled.extend(y[chosen])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    X_out = np.array(X_resampled)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    y_out = np.array(y_resampled)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    shuffle = rng.permutation(len(y_out))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return X_out[shuffle], y_out[shuffle]"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 4: Logistic regression with class weights"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def sigmoid(z):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return 1.0 / (1.0 + np.exp(-np.clip(z, -500, 500)))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def logistic_regression_weighted(X, y, weights, lr=0.01, epochs=200):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    n_samples, n_features = X.shape"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    w = np.zeros(n_features)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    b = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for _ in range(epochs):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        z = X @ w + b"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        pred = sigmoid(z)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        error = pred - y"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        weighted_error = error * weights"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        gradient_w = (X.T @ weighted_error) / n_samples"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        gradient_b = np.mean(weighted_error)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        w -= lr * gradient_w"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        b -= lr * gradient_b"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return w, b"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def compute_class_weights(y):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    classes, counts = np.unique(y, return_counts=True)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    n_samples = len(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    n_classes = len(classes)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    weight_map = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for cls, count in zip(classes, counts):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        weight_map[cls] = n_samples / (n_classes * count)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return np.array([weight_map[yi] for yi in y])"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 5: Threshold tuning"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def find_optimal_threshold(y_true, y_probs, metric=\"f1\"):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    best_threshold = 0.5"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    best_score = -1.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for threshold in np.arange(0.05, 0.96, 0.01):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        y_pred = (y_probs >= threshold).astype(int)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        tp = np.sum((y_pred == 1) & (y_true == 1))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        fp = np.sum((y_pred == 1) & (y_true == 0))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        fn = np.sum((y_pred == 0) & (y_true == 1))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if metric == \"f1\":"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            precision = tp / (tp + fp) if (tp + fp) > 0 else 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            recall = tp / (tp + fn) if (tp + fn) > 0 else 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            score = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        elif metric == \"recall\":"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            score = tp / (tp + fn) if (tp + fn) > 0 else 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        elif metric == \"precision\":"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            score = tp / (tp + fp) if (tp + fp) > 0 else 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if score > best_score:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            best_score = score"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            best_threshold = threshold"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return best_threshold, best_score"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 6: Evaluation functions"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def confusion_matrix_values(y_true, y_pred):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    tp = np.sum((y_pred == 1) & (y_true == 1))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    tn = np.sum((y_pred == 0) & (y_true == 0))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    fp = np.sum((y_pred == 1) & (y_true == 0))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    fn = np.sum((y_pred == 0) & (y_true == 1))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return tp, tn, fp, fn"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def compute_metrics(y_true, y_pred):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    tp, tn, fp, fn = confusion_matrix_values(y_true, y_pred)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    accuracy = (tp + tn) / (tp + tn + fp + fn)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    precision = tp / (tp + fp) if (tp + fp) > 0 else 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    recall = tp / (tp + fn) if (tp + fn) > 0 else 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    denom = np.sqrt(float((tp + fp) * (tp + fn) * (tn + fp) * (tn + fn)))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    mcc = (tp * tn - fp * fn) / denom if denom > 0 else 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return {"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"accuracy\": accuracy,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"precision\": precision,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"recall\": recall,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"f1\": f1,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        \"mcc\": mcc,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    }"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 7: Compare all approaches"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "X, y = make_imbalanced_data(950, 50, seed=42)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "split = int(0.8 * len(y))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "X_train, X_test = X[:split], X[split:]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "y_train, y_test = y[:split], y[split:]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# Baseline: no treatment"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "w_base, b_base = logistic_regression_weighted("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    X_train, y_train, np.ones(len(y_train)), lr=0.1, epochs=300"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "probs_base = sigmoid(X_test @ w_base + b_base)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "preds_base = (probs_base >= 0.5).astype(int)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# Oversampled"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "X_over, y_over = random_oversample(X_train, y_train)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "w_over, b_over = logistic_regression_weighted("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    X_over, y_over, np.ones(len(y_over)), lr=0.1, epochs=300"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "preds_over = (sigmoid(X_test @ w_over + b_over) >= 0.5).astype(int)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# SMOTE"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "minority_mask = y_train == 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "X_minority = X_train[minority_mask]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "synthetic = smote(X_minority, k=5, n_synthetic=len(y_train) - 2 * int(minority_mask.sum()))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "X_smote = np.vstack([X_train, synthetic])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "y_smote = np.concatenate([y_train, np.ones(len(synthetic))])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "w_sm, b_sm = logistic_regression_weighted("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    X_smote, y_smote, np.ones(len(y_smote)), lr=0.1, epochs=300"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "preds_smote = (sigmoid(X_test @ w_sm + b_sm) >= 0.5).astype(int)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# Class weights"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "sample_weights = compute_class_weights(y_train)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "w_cw, b_cw = logistic_regression_weighted("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    X_train, y_train, sample_weights, lr=0.1, epochs=300"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "probs_cw = sigmoid(X_test @ w_cw + b_cw)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "preds_cw = (probs_cw >= 0.5).astype(int)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# Threshold tuning (tune on held-out validation set, not test set)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "probs_val = sigmoid(X_val @ w_cw + b_cw)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "best_thresh, best_f1 = find_optimal_threshold(y_val, probs_val, metric=\"f1\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "preds_thresh = (probs_cw >= best_thresh).astype(int)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
