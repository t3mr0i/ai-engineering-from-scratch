{
  "cells": [
    {
      "cell_type": "markdown",
      "source": [
        "# Linear Regression Notebook\n\n> Hands-on Build It and Exercises."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Build It"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 1: Generate sample data"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import random"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import math"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "random.seed(42)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "TRUE_W = 3.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "TRUE_B = 7.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "N_SAMPLES = 100"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "X = [random.uniform(0, 10) for _ in range(N_SAMPLES)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "y = [TRUE_W * x + TRUE_B + random.gauss(0, 2.0) for x in X]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"Generated {N_SAMPLES} samples\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"True relationship: y = {TRUE_W}x + {TRUE_B} (+ noise)\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"First 5 points: {[(round(X[i], 2), round(y[i], 2)) for i in range(5)]}\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 2: Linear regression from scratch with gradient descent"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class LinearRegression:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, learning_rate=0.01):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.w = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.b = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.lr = learning_rate"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.cost_history = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def predict(self, X):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return [self.w * x + self.b for x in X]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def compute_cost(self, X, y):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        predictions = self.predict(X)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        n = len(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        cost = sum((pred - actual) ** 2 for pred, actual in zip(predictions, y)) / n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return cost"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def compute_gradients(self, X, y):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        predictions = self.predict(X)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        n = len(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        dw = (2 / n) * sum((pred - actual) * x for pred, actual, x in zip(predictions, y, X))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        db = (2 / n) * sum(pred - actual for pred, actual in zip(predictions, y))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return dw, db"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def fit(self, X, y, epochs=1000, print_every=200):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for epoch in range(epochs):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            dw, db = self.compute_gradients(X, y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.w -= self.lr * dw"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.b -= self.lr * db"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            cost = self.compute_cost(X, y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.cost_history.append(cost)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if epoch % print_every == 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                print(f\"  Epoch {epoch:4d} | Cost: {cost:.4f} | w: {self.w:.4f} | b: {self.b:.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return self"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def r_squared(self, X, y):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        predictions = self.predict(X)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        y_mean = sum(y) / len(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        ss_res = sum((actual - pred) ** 2 for actual, pred in zip(y, predictions))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        ss_tot = sum((actual - y_mean) ** 2 for actual in y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return 1 - (ss_res / ss_tot)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(\"=== Training Linear Regression (Gradient Descent) ===\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "model = LinearRegression(learning_rate=0.005)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "model.fit(X, y, epochs=1000, print_every=200)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"\\nLearned: y = {model.w:.4f}x + {model.b:.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"True:    y = {TRUE_W}x + {TRUE_B}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"R-squared: {model.r_squared(X, y):.4f}\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Try It: break it, then fix it"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Reading working code is not the same as understanding it. The two cells below"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "each have a problem. Predict what happens *before* you run them \u2014 then run, see"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "the failure, and fix it. The failure is the lesson."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "**A. The learning rate is too large.**"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Before running: the model above used `learning_rate=0.005` and converged. This"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "one uses `0.5` \u2014 100x larger. Write down your prediction: does it converge"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "faster, converge to the same answer, or something else? Then run it."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# Same model as Step 2, but learning_rate=0.5 instead of 0.005."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "model = LinearRegression(learning_rate=0.5)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "model.fit(X, y, epochs=30, print_every=5)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"\\nLearned: y = {model.w:.4g}x + {model.b:.4g}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"True:    y = {TRUE_W}x + {TRUE_B}\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "You should see the cost *grow* every step instead of shrinking \u2014 `5e2`, then"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "`5e17`, then `4e32` \u2014 and `w` flip sign on each epoch. The steps are so large"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "that gradient descent overshoots the minimum and bounces further out each time."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "This is divergence, and it is the single most common reason \"my model won't"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "train.\" **Fix it:** change `0.5` back to a small value (try `0.01`, `0.005`,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "`0.001`) and re-run until the cost shrinks toward zero. There is no single right"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "answer \u2014 that is the point. The learning rate is a dial you tune by watching the"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "cost."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "**B. Fill in the missing gradient.**"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "The `compute_gradients` method below is blank. This is the heart of the whole"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "algorithm \u2014 the partial derivatives of MSE with respect to `w` and `b`. Derive"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "them and fill them in. The self-check at the bottom compares your formula"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "against a numerical gradient and tells you if you got it right \u2014 no need to"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "trust the lesson, the math checks itself."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class LinearRegressionGap(LinearRegression):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def compute_gradients(self, X, y):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        predictions = self.predict(X)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        n = len(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        # TODO: replace these two lines."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        # dw is the partial derivative of MSE w.r.t. w; db w.r.t. b."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        # Hint: MSE = (1/n) * sum((w*x + b - y)^2). Differentiate, and the"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        # factor of 2 from the square comes out front."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        dw = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        db = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return dw, db"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# --- self-check: do not edit below this line ---"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "m = LinearRegressionGap()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "m.w, m.b = 1.5, 2.0          # arbitrary point to test the gradient at"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "dw, db = m.compute_gradients(X, y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def _cost_at(w, b):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return sum((w * xi + b - a) ** 2 for xi, a in zip(X, y)) / len(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "h = 1e-4"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "num_dw = (_cost_at(1.5 + h, 2.0) - _cost_at(1.5 - h, 2.0)) / (2 * h)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "num_db = (_cost_at(1.5, 2.0 + h) - _cost_at(1.5, 2.0 - h)) / (2 * h)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "if abs(dw - num_dw) < 1e-2 and abs(db - num_db) < 1e-2:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(\"PASS \u2014 your gradient matches the numerical check.\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(f\"  your dw={dw:.3f}, db={db:.3f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "else:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(\"Not yet. Your gradient does not match the numerical slope.\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(f\"  you got    dw={dw:.3f}, db={db:.3f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(f\"  should be  dw={num_dw:.3f}, db={num_db:.3f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(\"  Re-derive d/dw and d/db of the mean squared error.\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "When it prints `PASS`, you have implemented gradient descent's core yourself \u2014"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "not read it, derived it. The solution is the `compute_gradients` you saw in"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Step 2; only check it after you have tried."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 3: Normal equation (closed-form solution)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class LinearRegressionNormal:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.w = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.b = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def fit(self, X, y):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        n = len(X)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        x_mean = sum(X) / n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        y_mean = sum(y) / n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        numerator = sum((X[i] - x_mean) * (y[i] - y_mean) for i in range(n))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        denominator = sum((X[i] - x_mean) ** 2 for i in range(n))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.w = numerator / denominator"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.b = y_mean - self.w * x_mean"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return self"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def predict(self, X):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return [self.w * x + self.b for x in X]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def r_squared(self, X, y):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        predictions = self.predict(X)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        y_mean = sum(y) / len(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        ss_res = sum((actual - pred) ** 2 for actual, pred in zip(y, predictions))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        ss_tot = sum((actual - y_mean) ** 2 for actual in y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return 1 - (ss_res / ss_tot)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(\"\\n=== Normal Equation (Closed-Form) ===\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "model_normal = LinearRegressionNormal()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "model_normal.fit(X, y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"Learned: y = {model_normal.w:.4f}x + {model_normal.b:.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"R-squared: {model_normal.r_squared(X, y):.4f}\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 4: Multiple linear regression"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class MultipleLinearRegression:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, n_features, learning_rate=0.01):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.weights = [0.0] * n_features"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.bias = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.lr = learning_rate"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.cost_history = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def predict_single(self, x):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return sum(w * xi for w, xi in zip(self.weights, x)) + self.bias"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def predict(self, X):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return [self.predict_single(x) for x in X]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def compute_cost(self, X, y):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        predictions = self.predict(X)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        n = len(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return sum((pred - actual) ** 2 for pred, actual in zip(predictions, y)) / n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def fit(self, X, y, epochs=1000, print_every=200):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        n = len(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        n_features = len(X[0])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for epoch in range(epochs):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            predictions = self.predict(X)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            errors = [pred - actual for pred, actual in zip(predictions, y)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for j in range(n_features):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                grad = (2 / n) * sum(errors[i] * X[i][j] for i in range(n))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self.weights[j] -= self.lr * grad"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            grad_b = (2 / n) * sum(errors)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.bias -= self.lr * grad_b"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            cost = self.compute_cost(X, y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.cost_history.append(cost)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if epoch % print_every == 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                print(f\"  Epoch {epoch:4d} | Cost: {cost:.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return self"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def r_squared(self, X, y):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        predictions = self.predict(X)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        y_mean = sum(y) / len(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        ss_res = sum((actual - pred) ** 2 for actual, pred in zip(y, predictions))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        ss_tot = sum((actual - y_mean) ** 2 for actual in y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return 1 - (ss_res / ss_tot)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "random.seed(42)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "N = 100"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "X_multi = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "y_multi = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "for _ in range(N):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    size = random.uniform(500, 3000)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    bedrooms = random.randint(1, 5)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    age = random.uniform(0, 50)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    price = 50 * size + 10000 * bedrooms - 1000 * age + 50000 + random.gauss(0, 20000)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    X_multi.append([size, bedrooms, age])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    y_multi.append(price)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def standardize(X):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    n_features = len(X[0])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    means = [sum(X[i][j] for i in range(len(X))) / len(X) for j in range(n_features)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    stds = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for j in range(n_features):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        variance = sum((X[i][j] - means[j]) ** 2 for i in range(len(X))) / len(X)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        stds.append(variance ** 0.5)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    X_scaled = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for i in range(len(X)):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        row = [(X[i][j] - means[j]) / stds[j] if stds[j] > 0 else 0 for j in range(n_features)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        X_scaled.append(row)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return X_scaled, means, stds"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "y_mean_val = sum(y_multi) / len(y_multi)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "y_std_val = (sum((yi - y_mean_val) ** 2 for yi in y_multi) / len(y_multi)) ** 0.5"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "y_scaled = [(yi - y_mean_val) / y_std_val for yi in y_multi]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "X_scaled, x_means, x_stds = standardize(X_multi)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(\"\\n=== Multiple Linear Regression (3 features) ===\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(\"Features: house size, bedrooms, age\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "multi_model = MultipleLinearRegression(n_features=3, learning_rate=0.01)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "multi_model.fit(X_scaled, y_scaled, epochs=1000, print_every=200)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"\\nWeights (standardized): {[round(w, 4) for w in multi_model.weights]}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"Bias (standardized): {multi_model.bias:.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"R-squared: {multi_model.r_squared(X_scaled, y_scaled):.4f}\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 5: Polynomial regression"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class PolynomialRegression:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, degree, learning_rate=0.01):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.degree = degree"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.weights = [0.0] * degree"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.bias = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.lr = learning_rate"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def make_features(self, X):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return [[x ** (d + 1) for d in range(self.degree)] for x in X]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def predict(self, X):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        features = self.make_features(X)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return [sum(w * f for w, f in zip(self.weights, row)) + self.bias for row in features]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def fit(self, X, y, epochs=1000, print_every=200):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        features = self.make_features(X)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        n = len(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for epoch in range(epochs):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            predictions = [sum(w * f for w, f in zip(self.weights, row)) + self.bias for row in features]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            errors = [pred - actual for pred, actual in zip(predictions, y)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for j in range(self.degree):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                grad = (2 / n) * sum(errors[i] * features[i][j] for i in range(n))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self.weights[j] -= self.lr * grad"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            grad_b = (2 / n) * sum(errors)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.bias -= self.lr * grad_b"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if epoch % print_every == 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                cost = sum(e ** 2 for e in errors) / n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                print(f\"  Epoch {epoch:4d} | Cost: {cost:.6f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return self"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def r_squared(self, X, y):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        predictions = self.predict(X)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        y_mean = sum(y) / len(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        ss_res = sum((actual - pred) ** 2 for actual, pred in zip(y, predictions))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        ss_tot = sum((actual - y_mean) ** 2 for actual in y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return 1 - (ss_res / ss_tot)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "random.seed(42)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "X_poly = [x / 10.0 for x in range(0, 50)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "y_poly = [0.5 * x ** 2 - 2 * x + 3 + random.gauss(0, 1.0) for x in X_poly]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "x_max = max(abs(x) for x in X_poly)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "X_poly_norm = [x / x_max for x in X_poly]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "y_poly_mean = sum(y_poly) / len(y_poly)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "y_poly_std = (sum((yi - y_poly_mean) ** 2 for yi in y_poly) / len(y_poly)) ** 0.5"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "y_poly_norm = [(yi - y_poly_mean) / y_poly_std for yi in y_poly]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(\"\\n=== Polynomial Regression (degree 2 vs degree 5) ===\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(\"True relationship: y = 0.5x^2 - 2x + 3\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(\"\\nDegree 2:\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "poly2 = PolynomialRegression(degree=2, learning_rate=0.1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "poly2.fit(X_poly_norm, y_poly_norm, epochs=2000, print_every=500)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"  R-squared: {poly2.r_squared(X_poly_norm, y_poly_norm):.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(\"\\nDegree 5:\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "poly5 = PolynomialRegression(degree=5, learning_rate=0.1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "poly5.fit(X_poly_norm, y_poly_norm, epochs=2000, print_every=500)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"  R-squared: {poly5.r_squared(X_poly_norm, y_poly_norm):.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(\"\\nDegree 2 fits the true curve well. Degree 5 fits training data slightly better\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(\"but risks overfitting on new data.\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 6: Ridge regression (L2 regularization)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class RidgeRegression:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, n_features, learning_rate=0.01, alpha=1.0):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.weights = [0.0] * n_features"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.bias = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.lr = learning_rate"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.alpha = alpha"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def predict_single(self, x):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return sum(w * xi for w, xi in zip(self.weights, x)) + self.bias"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def predict(self, X):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return [self.predict_single(x) for x in X]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def fit(self, X, y, epochs=1000, print_every=200):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        n = len(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        n_features = len(X[0])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for epoch in range(epochs):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            predictions = self.predict(X)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            errors = [pred - actual for pred, actual in zip(predictions, y)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            mse = sum(e ** 2 for e in errors) / n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            reg_term = self.alpha * sum(w ** 2 for w in self.weights)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            cost = mse + reg_term"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for j in range(n_features):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                grad = (2 / n) * sum(errors[i] * X[i][j] for i in range(n))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                grad += 2 * self.alpha * self.weights[j]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self.weights[j] -= self.lr * grad"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            grad_b = (2 / n) * sum(errors)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.bias -= self.lr * grad_b"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if epoch % print_every == 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                print(f\"  Epoch {epoch:4d} | Cost: {cost:.4f} | L2 penalty: {reg_term:.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return self"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(\"\\n=== Ridge Regression (L2 Regularization) ===\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(\"Same data as multiple regression, with alpha=0.1\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "ridge = RidgeRegression(n_features=3, learning_rate=0.01, alpha=0.1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "ridge.fit(X_scaled, y_scaled, epochs=1000, print_every=200)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"\\nRidge weights: {[round(w, 4) for w in ridge.weights]}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"Plain weights: {[round(w, 4) for w in multi_model.weights]}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(\"Ridge weights are smaller (shrunk toward zero) due to the L2 penalty.\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
