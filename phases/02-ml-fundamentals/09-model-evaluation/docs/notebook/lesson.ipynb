    {
      "cell_type": "markdown",
      "source": [
        "def standardize(values):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    n = len(values)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    mean = sum(values) / n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    var = sum((v - mean) ** 2 for v in values) / n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    std = math.sqrt(var) if var > 0 else 1.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return [(v - mean) / std for v in values], mean, std"
      ]
    },
