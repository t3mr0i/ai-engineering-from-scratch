    {
      "cell_type": "markdown",
      "source": [
        "def make_imbalanced_data(n=300, minority_ratio=0.05, seed=42):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    random.seed(seed)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    X = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    y = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for _ in range(n):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if random.random() < minority_ratio:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            x1 = random.gauss(3, 0.5)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            x2 = random.gauss(3, 0.5)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            label = 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        else:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            x1 = random.gauss(0, 1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            x2 = random.gauss(0, 1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            label = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        X.append([x1, x2])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        y.append(label)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return X, y"
      ]
    },
