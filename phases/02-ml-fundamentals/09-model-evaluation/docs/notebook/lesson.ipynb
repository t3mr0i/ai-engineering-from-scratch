      "source": [
        "        x2 = random.uniform(0, 5)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        target = 3 * x1 + 2 * x2 + random.gauss(0, 2)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        X.append([x1, x2])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        y.append(target)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return X, y"
