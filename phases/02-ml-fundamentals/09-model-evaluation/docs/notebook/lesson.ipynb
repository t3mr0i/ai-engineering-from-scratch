    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(\"\\n=== Learning Curve ===\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    sizes, train_sc, val_sc = learning_curve("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        X_clf, y_clf,"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        model_fn=lambda: SimpleLogistic(lr=0.1, epochs=200),"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        metric_fn=accuracy,"
