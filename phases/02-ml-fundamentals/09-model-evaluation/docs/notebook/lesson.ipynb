    {
      "cell_type": "markdown",
      "source": [
        "def make_regression_data(n=200, seed=42):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    random.seed(seed)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    X = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    y = []"
