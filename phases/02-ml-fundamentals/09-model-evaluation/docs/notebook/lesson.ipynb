    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(f\"  RMSE:      {rmse(y_te_r, y_pred_r):.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(f\"  MAE:       {mae(y_te_r, y_pred_r):.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(f\"  R-squared: {r_squared(y_te_r, y_pred_r):.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    mean_baseline = [sum(y_tr_r) / len(y_tr_r)] * len(y_te_r)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(f\"\\n  Mean baseline:\")"
