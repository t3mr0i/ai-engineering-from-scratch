    {
      "cell_type": "markdown",
      "source": [
        "    y_pred_imb = [model_imb.predict(x) for x in X_te_i]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(f\"\\n  Trained model on imbalanced data:\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
