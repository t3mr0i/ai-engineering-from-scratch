      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class KDTree:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, X, indices=None, depth=0):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        # Recursively partition the data"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.axis = depth % len(X[0])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        # Split on median of the current axis"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        ..."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def query(self, point, k=1):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        # Traverse to leaf, then backtrack"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        ..."
