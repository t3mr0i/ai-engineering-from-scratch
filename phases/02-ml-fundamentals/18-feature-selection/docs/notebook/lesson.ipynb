      "source": [
        "    best_threshold = None"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    best_gain = -1.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for f in feature_subset:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        threshold, gain = best_split(X, y, f)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if gain > best_gain:"
      ]
    },
    {
      "cell_type": "markdown",
