{
  "cells": [
    {
      "cell_type": "markdown",
      "source": [
        "# Logistic Regression Notebook\n\n> Hands-on Build It and Exercises."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Build It"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 1: Sigmoid function and data generation"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import random"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import math"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def sigmoid(z):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    z = max(-500, min(500, z))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return 1.0 / (1.0 + math.exp(-z))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "random.seed(42)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "N = 200"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "X = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "y = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "for _ in range(N // 2):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    X.append([random.gauss(2, 1), random.gauss(2, 1)])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    y.append(0)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "for _ in range(N // 2):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    X.append([random.gauss(5, 1), random.gauss(5, 1)])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    y.append(1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "combined = list(zip(X, y))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "random.shuffle(combined)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "X, y = zip(*combined)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "X = list(X)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "y = list(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"Generated {N} samples (2 classes, 2 features)\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"Class 0 center: (2, 2), Class 1 center: (5, 5)\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"First 5 samples:\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "for i in range(5):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(f\"  Features: [{X[i][0]:.2f}, {X[i][1]:.2f}], Label: {y[i]}\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 2: Logistic regression from scratch"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class LogisticRegression:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, n_features, learning_rate=0.01):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.weights = [0.0] * n_features"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.bias = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.lr = learning_rate"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.loss_history = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def predict_proba(self, x):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        z = sum(w * xi for w, xi in zip(self.weights, x)) + self.bias"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return sigmoid(z)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def predict(self, x, threshold=0.5):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return 1 if self.predict_proba(x) >= threshold else 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def compute_loss(self, X, y):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        n = len(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        total = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i in range(n):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            p = self.predict_proba(X[i])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            p = max(1e-15, min(1 - 1e-15, p))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            total += y[i] * math.log(p) + (1 - y[i]) * math.log(1 - p)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return -total / n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def fit(self, X, y, epochs=1000, print_every=200):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        n = len(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        n_features = len(X[0])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for epoch in range(epochs):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            dw = [0.0] * n_features"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            db = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for i in range(n):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                p = self.predict_proba(X[i])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                error = p - y[i]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                for j in range(n_features):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                    dw[j] += error * X[i][j]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                db += error"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for j in range(n_features):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self.weights[j] -= self.lr * (dw[j] / n)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.bias -= self.lr * (db / n)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            loss = self.compute_loss(X, y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            self.loss_history.append(loss)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if epoch % print_every == 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                print(f\"  Epoch {epoch:4d} | Loss: {loss:.4f} | w: [{self.weights[0]:.3f}, {self.weights[1]:.3f}] | b: {self.bias:.3f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return self"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def accuracy(self, X, y):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        correct = sum(1 for i in range(len(y)) if self.predict(X[i]) == y[i])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return correct / len(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "split = int(0.8 * N)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "X_train, X_test = X[:split], X[split:]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "y_train, y_test = y[:split], y[split:]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(\"\\n=== Training Logistic Regression ===\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "model = LogisticRegression(n_features=2, learning_rate=0.1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "model.fit(X_train, y_train, epochs=1000, print_every=200)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"\\nTrain accuracy: {model.accuracy(X_train, y_train):.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"Test accuracy:  {model.accuracy(X_test, y_test):.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"Weights: [{model.weights[0]:.4f}, {model.weights[1]:.4f}]\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"Bias: {model.bias:.4f}\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 3: Confusion matrix and metrics from scratch"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class ClassificationMetrics:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, y_true, y_pred):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.tp = sum(1 for t, p in zip(y_true, y_pred) if t == 1 and p == 1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.tn = sum(1 for t, p in zip(y_true, y_pred) if t == 0 and p == 0)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.fp = sum(1 for t, p in zip(y_true, y_pred) if t == 0 and p == 1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.fn = sum(1 for t, p in zip(y_true, y_pred) if t == 1 and p == 0)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def accuracy(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        total = self.tp + self.tn + self.fp + self.fn"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return (self.tp + self.tn) / total if total > 0 else 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def precision(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        denom = self.tp + self.fp"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return self.tp / denom if denom > 0 else 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def recall(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        denom = self.tp + self.fn"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return self.tp / denom if denom > 0 else 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def f1(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        p = self.precision()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        r = self.recall()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return 2 * p * r / (p + r) if (p + r) > 0 else 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def print_confusion_matrix(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(f\"\\n  Confusion Matrix:\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(f\"                  Predicted\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(f\"                  Pos   Neg\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(f\"  Actual Pos     {self.tp:4d}  {self.fn:4d}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(f\"  Actual Neg     {self.fp:4d}  {self.tn:4d}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def print_report(self):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.print_confusion_matrix()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(f\"\\n  Accuracy:  {self.accuracy():.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(f\"  Precision: {self.precision():.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(f\"  Recall:    {self.recall():.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        print(f\"  F1 Score:  {self.f1():.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "y_pred_test = [model.predict(x) for x in X_test]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(\"\\n=== Classification Report (Test Set) ===\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "metrics = ClassificationMetrics(y_test, y_pred_test)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "metrics.print_report()"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 4: Decision boundary analysis"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(\"\\n=== Decision Boundary ===\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "w1, w2 = model.weights"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "b = model.bias"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(f\"Decision boundary: {w1:.4f}*x1 + {w2:.4f}*x2 + {b:.4f} = 0\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "if abs(w2) > 1e-10:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(f\"Solved for x2:     x2 = {-w1/w2:.4f}*x1 + {-b/w2:.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "print(\"\\nSample predictions near the boundary:\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "test_points = ["
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    [3.0, 3.0],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    [3.5, 3.5],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    [4.0, 4.0],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    [2.5, 2.5],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    [5.0, 5.0],"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "for point in test_points:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    prob = model.predict_proba(point)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    pred = model.predict(point)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    print(f\"  [{point[0]}, {point[1]}] -> prob={prob:.4f}, class={pred}\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 5: Multi-class with softmax"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "class SoftmaxRegression:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def __init__(self, n_features, n_classes, learning_rate=0.01):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.n_features = n_features"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.n_classes = n_classes"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.lr = learning_rate"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.weights = [[0.0] * n_features for _ in range(n_classes)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        self.biases = [0.0] * n_classes"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def softmax(self, scores):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        max_score = max(scores)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        exp_scores = [math.exp(s - max_score) for s in scores]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        total = sum(exp_scores)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return [e / total for e in exp_scores]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def predict_proba(self, x):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        scores = ["
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            sum(self.weights[k][j] * x[j] for j in range(self.n_features)) + self.biases[k]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for k in range(self.n_classes)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        ]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return self.softmax(scores)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def predict(self, x):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        probs = self.predict_proba(x)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return probs.index(max(probs))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def fit(self, X, y, epochs=1000, print_every=200):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        n = len(y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for epoch in range(epochs):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            grad_w = [[0.0] * self.n_features for _ in range(self.n_classes)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            grad_b = [0.0] * self.n_classes"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            total_loss = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for i in range(n):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                probs = self.predict_proba(X[i])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                for k in range(self.n_classes):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                    target = 1.0 if y[i] == k else 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                    error = probs[k] - target"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                    for j in range(self.n_features):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                        grad_w[k][j] += error * X[i][j]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                    grad_b[k] += error"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                true_prob = max(probs[y[i]], 1e-15)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                total_loss -= math.log(true_prob)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for k in range(self.n_classes):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                for j in range(self.n_features):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                    self.weights[k][j] -= self.lr * (grad_w[k][j] / n)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                self.biases[k] -= self.lr * (grad_b[k] / n)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if epoch % print_every == 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                print(f\"  Epoch {epoch:4d} | Loss: {total_loss / n:.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return self"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    def accuracy(self, X, y):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        correct = sum(1 for i in range(len(y)) if self.predict(X[i]) == y[i])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return correct / len(y)"
      ]
    },
