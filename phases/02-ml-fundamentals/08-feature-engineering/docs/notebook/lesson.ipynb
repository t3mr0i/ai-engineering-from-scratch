    {
      "cell_type": "markdown",
      "source": [
        "### Step 5: Feature selection from scratch"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def correlation(x, y):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    n = len(x)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    mean_x = sum(x) / n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    mean_y = sum(y) / n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    cov = sum((xi - mean_x) * (yi - mean_y) for xi, yi in zip(x, y)) / n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    std_x = math.sqrt(sum((xi - mean_x) ** 2 for xi in x) / n)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    std_y = math.sqrt(sum((yi - mean_y) ** 2 for yi in y) / n)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if std_x == 0 or std_y == 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return cov / (std_x * std_y)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def mutual_information(feature, target, n_bins=10):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    feat_min = min(feature)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    feat_max = max(feature)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    bin_width = (feat_max - feat_min) / n_bins if feat_max != feat_min else 1.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    feat_binned = ["
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        min(int((f - feat_min) / bin_width), n_bins - 1) for f in feature"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    ]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    n = len(feature)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    target_classes = sorted(set(target))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    feat_bins = sorted(set(feat_binned))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    p_feat = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for b in feat_bins:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        p_feat[b] = feat_binned.count(b) / n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    p_target = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for t in target_classes:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        p_target[t] = target.count(t) / n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    mi = 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for b in feat_bins:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for t in target_classes:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            joint_count = sum("
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                1 for fb, tv in zip(feat_binned, target) if fb == b and tv == t"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            )"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            p_joint = joint_count / n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if p_joint > 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                mi += p_joint * math.log(p_joint / (p_feat[b] * p_target[t]))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return mi"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def variance_threshold(features, threshold=0.01):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    n_features = len(features[0])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    n_samples = len(features)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    selected = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for j in range(n_features):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        col = [features[i][j] for i in range(n_samples)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        mean = sum(col) / n_samples"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        var = sum((v - mean) ** 2 for v in col) / n_samples"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if var >= threshold:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            selected.append(j)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return selected"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def remove_correlated(features, threshold=0.9):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    n_features = len(features[0])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    n_samples = len(features)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    to_remove = set()"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for i in range(n_features):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if i in to_remove:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            continue"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        col_i = [features[r][i] for r in range(n_samples)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for j in range(i + 1, n_features):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if j in to_remove:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                continue"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            col_j = [features[r][j] for r in range(n_samples)]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            corr = abs(correlation(col_i, col_j))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if corr >= threshold:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                to_remove.add(j)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return [i for i in range(n_features) if i not in to_remove]"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
