    },
    {
      "cell_type": "markdown",
      "source": [
        "def tfidf(documents):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    n_docs = len(documents)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    vocab = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    idx = 0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for doc in documents:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for word in doc.lower().split():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if word not in vocab:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                vocab[word] = idx"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                idx += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    doc_freq = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
