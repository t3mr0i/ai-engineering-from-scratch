      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if word not in seen:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                doc_freq[word] = doc_freq.get(word, 0) + 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                seen.add(word)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    vectors = []"
