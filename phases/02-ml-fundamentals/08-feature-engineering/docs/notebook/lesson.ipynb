      "cell_type": "markdown",
      "source": [
        "### Step 2: Categorical encoding from scratch"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def one_hot_encode(values):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    categories = sorted(set(values))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    cat_to_idx = {cat: i for i, cat in enumerate(categories)}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    n_cats = len(categories)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    encoded = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for v in values:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        row = [0] * n_cats"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        row[cat_to_idx[v]] = 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        encoded.append(row)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return encoded, categories"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def label_encode(values):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    categories = sorted(set(values))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    cat_to_int = {cat: i for i, cat in enumerate(categories)}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return [cat_to_int[v] for v in values], cat_to_int"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def target_encode(feature_values, target_values, smoothing=10):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    global_mean = sum(target_values) / len(target_values)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    category_stats = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for feat, target in zip(feature_values, target_values):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        if feat not in category_stats:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            category_stats[feat] = {\"sum\": 0.0, \"count\": 0}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        category_stats[feat][\"sum\"] += target"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        category_stats[feat][\"count\"] += 1"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    encoding = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for cat, stats in category_stats.items():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        cat_mean = stats[\"sum\"] / stats[\"count\"]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        weight = stats[\"count\"] / (stats[\"count\"] + smoothing)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        encoding[cat] = weight * cat_mean + (1 - weight) * global_mean"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return [encoding[v] for v in feature_values], encoding"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
