    },
    {
      "cell_type": "markdown",
      "source": [
        "### Step 1: Numerical transforms from scratch"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "import math"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def min_max_scale(values):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    min_val = min(values)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    max_val = max(values)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if max_val == min_val:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return [0.0] * len(values)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return [(v - min_val) / (max_val - min_val) for v in values]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def standardize(values):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    n = len(values)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    mean = sum(values) / n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    variance = sum((v - mean) ** 2 for v in values) / n"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    std = math.sqrt(variance) if variance > 0 else 1.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return [(v - mean) / std for v in values]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def log_transform(values):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return [math.log(v + 1) for v in values]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def bin_values(values, n_bins=5):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    min_val = min(values)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    max_val = max(values)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    bin_width = (max_val - min_val) / n_bins"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if bin_width == 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return [0] * len(values)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    result = []"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    for v in values:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        bin_idx = int((v - min_val) / bin_width)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        bin_idx = min(bin_idx, n_bins - 1)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        result.append(bin_idx)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return result"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def polynomial_features(row, degree=2):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    n = len(row)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    result = list(row)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if degree >= 2:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i in range(n):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            result.append(row[i] ** 2)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for i in range(n):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            for j in range(i + 1, n):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "                result.append(row[i] * row[j])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return result"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```"
      ]
    },
