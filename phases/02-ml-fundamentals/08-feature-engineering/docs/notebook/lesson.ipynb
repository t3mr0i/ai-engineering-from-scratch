      "cell_type": "markdown",
      "source": [
        "### Step 4: Missing value imputation from scratch"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "```python"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def impute_mean(values):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    present = [v for v in values if v is not None]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if not present:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return [0.0] * len(values), 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    mean = sum(present) / len(present)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return [v if v is not None else mean for v in values], mean"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def impute_median(values):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    present = sorted(v for v in values if v is not None)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if not present:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        return [0.0] * len(values), 0.0"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    n = len(present)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    if n % 2 == 0:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        median = (present[n // 2 - 1] + present[n // 2]) / 2"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    else:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        median = present[n // 2]"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    return [v if v is not None else median for v in values], median"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "def impute_mode(values):"
