        "    for doc in documents:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "        for word in doc.lower().split():"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "            if word not in vocab:"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
