    },
    {
      "cell_type": "markdown",
      "source": [
        "def count_vectorize(documents):"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    vocab = {}"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "    idx = 0"
      ]
    },
    {
      "cell_type": "markdown",
